---
import TerminalReplay from '../../components/TerminalReplay.astro';
import '../../styles/global.css';
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>hipfire — recorded terminal replay</title>
  </head>
  <body>
    <main class="terminal-capture"><TerminalReplay /></main>
  </body>
</html>
<style is:global>
  .terminal-capture { width: 100vw; height: 100vh; padding: 32px 48px; display: grid; place-items: center; background: radial-gradient(ellipse at 50% 100%, rgba(225, 29, 42, 0.12), transparent 65%), #060607; }
  /* Video/GIF capture: no interactive controls. */
  .terminal-capture [data-replay-toggle] { display: none !important; }
  .terminal-capture .terminal-replay { height: 100%; --terminal-font: 15px; }
  .terminal-capture .terminal-replay-bar { min-height: 52px; font-size: 16px; }
  .terminal-capture .terminal-replay-label { font-size: 11px; }
  .terminal-capture .terminal-replay-footer { font-size: 13px; }
  @media (max-aspect-ratio: 1/1) {
    .terminal-capture { padding: 52px; }
    .terminal-capture .terminal-replay { --terminal-font: 19px; }
    .terminal-capture .terminal-replay-bar { min-height: 66px; font-size: 20px; }
    .terminal-capture .terminal-replay-label { font-size: 13px; padding-top: 14px; padding-bottom: 10px; }
    .terminal-capture .terminal-replay-footer { font-size: 16px; }
  }
</style>
