---
import Base from "../../layouts/Base.astro";
import { render, type CollectionEntry } from "astro:content";
import { toUrlSlug, buildDocsNav, githubSourceUrl, githubEditUrl } from "../../util/docs";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const { toUrlSlug } = await import("../../util/docs");
  const all = await getCollection("docs");
  return all.map((doc) => ({
    params: { slug: toUrlSlug(doc.id) },
    props: { doc, all },
  }));
}

interface Props {
  doc: CollectionEntry<"docs">;
  all: CollectionEntry<"docs">[];
}
const { doc, all } = Astro.props;
const { Content } = await render(doc);

const nav = buildDocsNav(all);
const title = doc.data.title;
const description = doc.data.description;
const sourceUrl = githubSourceUrl(doc.data.sourcePath);
const editUrl = githubEditUrl(doc.data.sourcePath);
const currentPath = `/docs/${toUrlSlug(doc.id)}`;
---

<Base title={title} description={description}>
  <div class="docs-layout">
    <aside class="docs-nav" aria-label="docs navigation">
      {nav.map((section) => (
        <>
          <h4>{section.label}</h4>
          <ul>
            {section.items.map((it) => (
              <li>
                <a
                  href={it.href}
                  class={currentPath === it.href ? "active" : undefined}
                >{it.title}</a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </aside>

    <main class="docs-content">
      <div class="prose-meta">
        <a href="/docs">/docs</a>
        <span class="docs-meta-sep">&middot;</span>
        <span class="docs-badge" title="Rendered from warpfront/hipfire beta">beta branch</span>
        <span class="docs-meta-sep">&middot;</span>
        <a href={sourceUrl}>view source</a>
        <span class="docs-meta-sep">&middot;</span>
        <a href={editUrl}>edit on GitHub</a>
      </div>
      <h1 class="prose-title">{title}</h1>
      <p class="prose-desc">{description}</p>
      <article class="prose">
        <Content />
      </article>
    </main>
  </div>
</Base>
