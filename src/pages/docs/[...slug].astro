---
import Base from "../../layouts/Base.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { toUrlSlug, pretty, groupOf } from "../../util/docs";

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content");
  const { toUrlSlug } = await import("../../util/docs");
  const all = await getCollection("docs");
  return all.map((doc) => ({
    params: { slug: toUrlSlug(doc.id) },
    props: { doc, all },
  }));
}

interface Props {
  doc: CollectionEntry<"docs">;
  all: CollectionEntry<"docs">[];
}
const { doc, all } = Astro.props;
const { Content } = await render(doc);

const groups: Record<string, { id: string; slug: string; title: string }[]> = {
  reference: [],
  methodology: [],
  "quant formats": [],
  "perf checkpoints": [],
};
for (const d of all) {
  const g = groupOf(d.id);
  groups[g].push({ id: d.id, slug: toUrlSlug(d.id), title: pretty(d.id, d.data.title) });
}
for (const g of Object.values(groups)) g.sort((a, b) => a.title.localeCompare(b.title));

const title = pretty(doc.id, doc.data.title);
const description =
  doc.data.description ?? `${title} — hipfire documentation`;
const editUrl = `https://github.com/Kaden-Schutt/hipfire/blob/master/docs/${doc.id}.md`;
const currentPath = `/docs/${toUrlSlug(doc.id)}`;
---

<Base title={title} description={description}>
  <div class="docs-layout">
    <aside class="docs-nav" aria-label="docs navigation">
      {Object.entries(groups).map(([group, items]) => items.length > 0 && (
        <>
          <h4>{group}</h4>
          <ul>
            {items.map((it) => (
              <li>
                <a
                  href={`/docs/${it.slug}`}
                  class={currentPath === `/docs/${it.slug}` ? "active" : ""}
                >{it.title}</a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </aside>

    <main class="docs-content">
      <div class="prose-meta">
        <a href="/docs">/docs</a> &middot; <a href={editUrl}>edit on github</a>
      </div>
      {doc.data.title && <h1 class="prose-title">{doc.data.title}</h1>}
      {doc.data.description && <p class="prose-desc">{doc.data.description}</p>}
      <article class="prose">
        <Content />
      </article>
    </main>
  </div>
</Base>
