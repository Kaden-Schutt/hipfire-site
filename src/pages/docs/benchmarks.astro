---
import Base from "../../layouts/Base.astro";
import { fetchHipfireRows, archOf, archGen, parseNotes, modeOf, hardwareLabel, bucketByArch } from "../../util/lmx";
import {
  ENGINE_REPO_BLOB,
  ENGINE_REPO_TREE,
  FRESHNESS_NOTE,
  HETEROGENEOUS_NOTE,
  qwen36Mq4r,
  qwen38Mq4v2,
  deepseekV4FlashMq2r,
} from "../../data/performance";

// Live fetch at build time
const rows = await fetchHipfireRows();
const buckets = bucketByArch(rows);
const archOrder = ["gfx1100", "gfx1201", "gfx1151", "gfx1030", "gfx1010", "gfx942", "gfx906"];

// Sort archs in our preferred order, then any unknowns
const sortedArchs = archOrder.filter((a) => buckets.has(a)).concat(
  [...buckets.keys()].filter((a) => !archOrder.includes(a)),
);

const buildIso = new Date().toISOString();

const description = `Live cross-arch hipfire benchmark numbers, sourced from localmaxxing.com, plus fixture-scoped beta snapshots. ${rows.length} approved runs across ${buckets.size} architectures.`;

function fmtNum(n: number | null | undefined, digits = 1): string {
  return n == null ? "—" : n.toFixed(digits);
}
function fmtInt(n: number | null | undefined): string {
  return n == null ? "—" : Math.round(n).toString();
}
---

<Base title="benchmarks" description={description}>
  <div class="docs-layout">
    <aside class="docs-nav" aria-label="docs navigation">
      <h4>featured</h4>
      <ul>
        <li><a href="#featured-beta">beta snapshots</a></li>
        <li><a href="#qwen36-mq4r">Qwen3.6 MQ4R</a></li>
        <li><a href="#qwen38-mq4v2">Qwen3.8 MQ4V2</a></li>
        <li><a href="#deepseek-v4">DeepSeek V4</a></li>
      </ul>
      <h4>by arch</h4>
      <ul>
        {sortedArchs.map((a) => (
          <li><a href={`#${a}`}>{a} <span class="cell-sub">({archGen(a)})</span></a></li>
        ))}
      </ul>
      <h4>topics</h4>
      <ul>
        <li><a href="#methodology">Methodology</a></li>
        <li><a href="#reproducibility">Reproducibility</a></li>
        <li><a href="/docs/dflash">DFlash explained</a></li>
      </ul>
    </aside>

    <main class="docs-content">
      <div class="prose-meta">/docs/benchmarks</div>
      <h1 class="prose-title">benchmarks</h1>
      <p class="prose-desc">
        Build-time live ledger of cross-arch tok/s on hipfire, plus curated
        fixture-scoped snapshots from
        <a href={ENGINE_REPO_TREE}>warpfront/hipfire</a> <code>beta</code>.
        <strong>{rows.length} approved runs</strong> across
        <strong>{buckets.size} architectures</strong>, fetched from
        <a href="https://localmaxxing.com/leaderboard?engine=hipfire">localmaxxing.com</a>.
        Every live cell links to its <code>/runs/&lt;id&gt;</code> for reproducibility.
      </p>

      <article class="prose">
        <div class="card" style="margin: 0 0 28px; border-left: 3px solid var(--accent); padding: 18px 20px;">
          <p style="margin: 0 0 10px; color: var(--fg); font-size: 15px; line-height: 1.55; max-width: none;">
            <strong class="accent">Freshness / lifecycle.</strong>
            {FRESHNESS_NOTE}
          </p>
          <p style="margin: 0; color: var(--fg-dim); font-size: 13px; line-height: 1.55; max-width: none;">
            {HETEROGENEOUS_NOTE}
            Engine sources and methodology docs point at
            <a href={`${ENGINE_REPO_BLOB}/README.md`}>warpfront/hipfire@beta</a>.
          </p>
        </div>

        <p class="footnote">
          Last build: <code>{buildIso}</code> &middot;
          live source: <a href="https://localmaxxing.com/api/leaderboard?engineName=hipfire">GET /api/leaderboard?engineName=hipfire</a> &middot;
          engine: <a href={ENGINE_REPO_TREE}>github.com/warpfront/hipfire</a> branch <code>beta</code>
        </p>

        <section id="featured-beta">
          <h2>featured beta snapshots</h2>
          <p>
            Compact tables from the engine <code>beta</code> branch. Each block
            names its date (when known), fixture, method, and source file so
            the figures stay scoped to that measurement — not a lasting claim
            about every hipfire build.
          </p>

          <h3 id="qwen36-mq4r">Qwen3.6 35B-A3B MQ4R · single-GPU AR</h3>
          <p>{qwen36Mq4r.method}</p>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>GPU</th>
                  <th>arch</th>
                  <th class="num">TG128 AR</th>
                  <th class="num">8-turn avg</th>
                  <th class="num">final turn</th>
                </tr>
              </thead>
              <tbody>
                {qwen36Mq4r.rows.map((r) => (
                  <tr>
                    <td>{r.gpu}</td>
                    <td>{r.arch}</td>
                    <td class="num"><strong>{r.tg128Ar.toFixed(1)}</strong> tok/s</td>
                    <td class="num">{r.eightTurnAvg.toFixed(1)} tok/s</td>
                    <td class="num">{r.finalTurn}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Source:
            <a href={qwen36Mq4r.sourceUrl}>{qwen36Mq4r.sourceLabel}</a>
          </p>

          <h3 id="qwen38-mq4v2">
            Qwen3.8-27B MQ4V2 · {qwen38Mq4v2.date} · {qwen38Mq4v2.fixture}
          </h3>
          <p>{qwen38Mq4v2.method}</p>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>tier</th>
                  <th class="num">AR decode</th>
                  <th class="num">prefill</th>
                  <th class="num">DFlash</th>
                  <th class="num">τ</th>
                  <th class="num">bpw</th>
                </tr>
              </thead>
              <tbody>
                {qwen38Mq4v2.rows.map((r) => (
                  <tr>
                    <td><strong>{r.tier}</strong></td>
                    <td class="num">{r.ar.toFixed(1)} tok/s</td>
                    <td class="num">{r.prefill.toFixed(1)}</td>
                    <td class="num"><strong>{r.dflash.toFixed(1)}</strong> tok/s</td>
                    <td class="num">{r.tau.toFixed(2)}</td>
                    <td class="num">{r.bpw.toFixed(3)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Dated {qwen38Mq4v2.date}. Source:
            <a href={qwen38Mq4v2.sourceUrl}>{qwen38Mq4v2.sourceLabel}</a>
            (<code>{qwen38Mq4v2.sourcePath}</code>)
          </p>

          <h3 id="deepseek-v4">
            DeepSeek V4 Flash MQ2R · {deepseekV4FlashMq2r.fixture}
          </h3>
          <p>{deepseekV4FlashMq2r.method}</p>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>topology</th>
                  <th class="num">decode</th>
                  <th class="num">prefill</th>
                </tr>
              </thead>
              <tbody>
                {deepseekV4FlashMq2r.rows.map((r) => (
                  <tr>
                    <td><strong>{r.topology}</strong></td>
                    <td class="num"><strong>{r.decode.toFixed(1)}</strong> tok/s</td>
                    <td class="num">{r.prefill} tok/s</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Source:
            <a href={deepseekV4FlashMq2r.sourceUrl}>{deepseekV4FlashMq2r.sourceLabel}</a>
          </p>
        </section>

        <h2 id="live-ledger">live localmaxxing ledger</h2>
        <p>
          Architecture tables below are approved community runs pulled at this
          site build. They are a separate surface from the featured beta
          snapshots above — different harness, different fixtures. Do not treat
          a live cell and a dated snapshot as the same measurement.
        </p>

        {sortedArchs.map((arch) => {
          const cells = buckets.get(arch) ?? [];
          return (
            <section id={arch}>
              <h2>{arch} <span class="cell-sub">— {archGen(arch)}</span></h2>
              <div class="table-wrap">
                <table class="perf">
                  <thead>
                    <tr>
                      <th>hardware</th>
                      <th>model</th>
                      <th>q</th>
                      <th>mode</th>
                      <th class="num">decode tok/s</th>
                      <th class="num">prefill</th>
                      <th class="num">AR base</th>
                      <th class="num">× AR</th>
                      <th class="num">τ</th>
                      <th>run</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cells.map((r) => {
                      const np = parseNotes(r.notes);
                      const mode = modeOf(r);
                      return (
                        <tr>
                          <td>{hardwareLabel(r)}</td>
                          <td>{r.model.displayName}</td>
                          <td><code>{r.engine.quantization}</code></td>
                          <td>{mode}</td>
                          <td class="num"><strong>{fmtNum(r.tokSOut)}</strong></td>
                          <td class="num">{fmtInt(r.tokSPrefill)}</td>
                          <td class="num">{np.arBaseline ? fmtNum(np.arBaseline) : "—"}</td>
                          <td class="num accent">{np.speedup ? `${np.speedup.toFixed(2)}×` : "—"}</td>
                          <td class="num">{np.tau ? np.tau.toFixed(2) : "—"}</td>
                          <td><a href={`https://localmaxxing.com/runs/${r.id}`}><code class="cell-sub">{r.id.slice(0, 10)}…</code></a></td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              {cells.length > 0 && (
                <p class="footnote">
                  Engine: <code>{cells[0].engine.engineName}@{cells[0].engine.engineVersion}</code> &middot;
                  Submitter: @{cells[0].user.username}
                </p>
              )}
            </section>
          );
        })}

        <h2 id="methodology">methodology</h2>
        <p>
          Live localmaxxing cells follow a shared protocol so cross-arch
          comparisons inside that harness are meaningful. Featured beta
          snapshots use the method notes printed beside each table — those
          fixtures are not interchangeable with the live ledger.
        </p>
        <ul>
          <li><strong>Prompt</strong>: <code>benchmarks/prompts/merge_sort_thinking_off.txt</code>, md5 <code>253c7ac50857fe6d0e10fb0d2c5e35c0</code>, 27 input tokens. One newline-shape variant locks in a stable τ across runs. Source tree: <a href={`${ENGINE_REPO_BLOB}/benchmarks/prompts/merge_sort_thinking_off.txt`}>warpfront/hipfire@beta</a>.</li>
          <li><strong>Config</strong>: <code>--max 256 --temp 0.0 --no-chatml --kv-mode q8 --ctx 4096</code>, <code>prompt_normalize=on</code> (default since 2026-04-26).</li>
          <li><strong>Runs</strong>: one <code>--max 16</code> warmup per cell (discarded), then 3 timed runs at <code>--max 256</code>, median reported. AR baseline is a paired <code>--ar-baseline</code> run from the same binary on the same hardware.</li>
          <li><strong>Coherence</strong>: every submitted run produced readable <code>merge_sort</code> code &mdash; no attractors, token loops, or special-token leaks.</li>
          <li><strong>GPU isolation</strong>: <code>HIP_VISIBLE_DEVICES</code> per cell on hosts with multiple GPUs; no two cells share a GPU concurrently.</li>
        </ul>
        <p>
          Why this matters: a <strong>single newline change</strong> in the
          prompt can swing τ by 17% on 27B DFlash &mdash; same model, same
          flags, different token sequence. The prompt md5 is part of the
          claim.
        </p>
        <p>
          Engine docs and performance checkpoints live on
          <a href={ENGINE_REPO_TREE}>warpfront/hipfire</a> branch
          <code>beta</code> — see
          <a href={`${ENGINE_REPO_TREE}/docs`}>docs/</a> and
          <a href={`${ENGINE_REPO_TREE}/docs/perf-checkpoints`}>docs/perf-checkpoints/</a>.
        </p>

        <h2 id="reproducibility">reproducibility</h2>
        <p>Every live row carries the exact launch command in its localmaxxing notes. To repro any cell:</p>
        <pre class="code"><span class="prompt">$</span> hipfire pull <span class="str">&lt;model&gt;</span>

<span class="prompt">$</span> hipfire bench <span class="str">&lt;model&gt;</span> --spec dflash --runs 5 --warmups 3 \
    --max-tokens 256 --backend noslots --workload stateless --json</pre>
        <p>
          Prefer <code>hipfire bench</code> over <code>examples/dflash_spec_demo</code>:
          the demo runs raw open-ended continuation and under-reports by ~40%
          because it never hits the chatml + structured-thinking serve path
          (see <a href={`${ENGINE_REPO_BLOB}/AGENTS.md`}>AGENTS.md</a> on beta).
        </p>
        <p>
          For DFlash, the draft model is hosted at
          <a href="https://huggingface.co/z-lab/Qwen3.5-9B-DFlash">z-lab/Qwen3.5-9B-DFlash</a>
          and
          <a href="https://huggingface.co/z-lab/Qwen3.5-27B-DFlash">z-lab/Qwen3.5-27B-DFlash</a>.
          The native-head MQ4 conversion is shipped with hipfire's draft pulls
          (<code>hipfire pull qwen3.5:9b-dflash</code>).
        </p>

        <h2 id="submit-your-own">submit your own</h2>
        <p>
          Anyone with a hipfire build can submit. Install
          <code>lmx-bench</code> for a curated harness, or POST directly to
          <code>localmaxxing.com/api/benchmarks</code> with the schema from
          <a href="https://localmaxxing.com/en/api-docs">the API docs</a>.
          See an existing row's <code>engineFlags.commandSnippet</code> for the
          exact invocation to mirror. Build from
          <a href={ENGINE_REPO_TREE}>warpfront/hipfire</a> <code>beta</code>.
        </p>
      </article>
    </main>
  </div>
</Base>
