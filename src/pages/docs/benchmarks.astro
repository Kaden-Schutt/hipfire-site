---
import Base from "../../layouts/Base.astro";
import { fetchHipfireRows, archOf, archGen, parseNotes, modeOf, hardwareLabel, bucketByArch } from "../../util/lmx";
import {
  ENGINE_REPO_BLOB,
  ENGINE_REPO_TREE,
  FRESHNESS_NOTE,
  HETEROGENEOUS_NOTE,
  qwen36Mq4r,
  qwen38Mq4v2,
  deepseekV4FlashMq2r,
} from "../../data/performance";
import {
  RELEASE_URL,
  PATCH_URL,
  a3bFile,
  a3bPrefill,
  a3bDecode,
  flashNextRows,
  halo16k,
} from "../../data/release043";

const f0 = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 0 });
const x1 = (n: number) => `${n.toFixed(1)}×`;

// Live fetch at build time
const rows = await fetchHipfireRows();
const buckets = bucketByArch(rows);
const archOrder = ["gfx1100", "gfx1201", "gfx1151", "gfx1030", "gfx1010", "gfx942", "gfx906"];

// Sort archs in our preferred order, then any unknowns
const sortedArchs = archOrder.filter((a) => buckets.has(a)).concat(
  [...buckets.keys()].filter((a) => !archOrder.includes(a)),
);

const buildIso = new Date().toISOString();

const description = `Live cross-arch hipfire benchmark numbers, sourced from localmaxxing.com, plus fixture-scoped snapshots from the hipfire 0.4.3 and 0.4.3.1 releases. ${rows.length} approved runs across ${buckets.size} architectures.`;

function fmtNum(n: number | null | undefined, digits = 1): string {
  return n == null ? "—" : n.toFixed(digits);
}
function fmtInt(n: number | null | undefined): string {
  return n == null ? "—" : Math.round(n).toString();
}
---

<Base title="benchmarks" description={description}>
  <div class="docs-layout">
    <aside class="docs-nav" aria-label="docs navigation">
      <h4>featured</h4>
      <ul>
        <li><a href="/benchmarks/0.4.3">0.4.3 release numbers</a></li>
        <li><a href="/benchmarks/0.4.2">0.4.2 release numbers</a></li>
        <li><a href="/benchmarks/0.4.1">0.4.1 release numbers</a></li>
        <li><a href="#featured">0.4.3 snapshots</a></li>
        <li><a href="#a3b-mq4rs">A3B mq4rs</a></li>
        <li><a href="#flash-next">Flash-Next</a></li>
        <li><a href="#historical">historical snapshots</a></li>
      </ul>
      <h4>by arch</h4>
      <ul>
        {sortedArchs.map((a) => (
          <li><a href={`#${a}`}>{a} <span class="cell-sub">({archGen(a)})</span></a></li>
        ))}
      </ul>
      <h4>topics</h4>
      <ul>
        <li><a href="#methodology">Methodology</a></li>
        <li><a href="#reproducibility">Reproducibility</a></li>
        <li><a href="/docs/dflash">DFlash explained</a></li>
      </ul>
    </aside>

    <main class="docs-content">
      <div class="prose-meta">/docs/benchmarks</div>
      <h1 class="prose-title">benchmarks</h1>
      <p class="prose-desc">
        Build-time live ledger of cross-arch tok/s on hipfire, plus curated
        fixture-scoped snapshots from the
        <a href={RELEASE_URL}>0.4.3</a> and <a href={PATCH_URL}>0.4.3.1</a> releases.
        <strong>{rows.length} approved runs</strong> across
        <strong>{buckets.size} architectures</strong>, fetched from
        <a href="https://localmaxxing.com/leaderboard?engine=hipfire">localmaxxing.com</a>.
        Every live cell links to its <code>/runs/&lt;id&gt;</code> for reproducibility.
      </p>

      <article class="prose">
        <div class="card" style="margin: 0 0 28px; border-left: 3px solid var(--accent); padding: 18px 20px;">
          <p style="margin: 0 0 10px; color: var(--fg); font-size: 15px; line-height: 1.55; max-width: none;">
            <strong class="accent">Freshness / lifecycle.</strong>
            {FRESHNESS_NOTE}
          </p>
          <p style="margin: 0; color: var(--fg-dim); font-size: 13px; line-height: 1.55; max-width: none;">
            {HETEROGENEOUS_NOTE}
            Engine sources and methodology docs point at
            <a href={`${ENGINE_REPO_BLOB}/README.md`}>warpfront/hipfire</a> (the current release, v0.4.3.1).
          </p>
        </div>

        <div class="card" style="margin: 0 0 28px; border-left: 3px solid var(--ok); padding: 18px 20px;">
          <p style="margin: 0; color: var(--fg); font-size: 14px; line-height: 1.55; max-width: none;">
            <strong class="ok">hipfire 0.4.3.</strong>
            The current release is 0.4.3.1 (0.4.3 and its patch, both 2026-10-24). Its numbers (A3B prefill 0.4.2.1 vs 0.4.3,
            A3B mq4rs decode, Flash-Next prefill on the Radeon AI PRO R9700 and Strix Halo) live on
            the <a href="/benchmarks/0.4.3">0.4.3 benchmarks page</a> with their fixtures and sources. Earlier releases
            keep their pages: <a href="/benchmarks/0.4.2">0.4.2</a> and <a href="/benchmarks/0.4.1">0.4.1</a>. The
            <a href="#historical">historical snapshots</a> at the end of the featured section predate 0.4.1.
          </p>
        </div>

        <p class="footnote">
          Last build: <code>{buildIso}</code> &middot;
          live source: <a href="https://localmaxxing.com/api/leaderboard?engineName=hipfire">GET /api/leaderboard?engineName=hipfire</a> &middot;
          engine: <a href={ENGINE_REPO_TREE}>github.com/warpfront/hipfire</a> current release <code>v0.4.3.1</code>; optimization continues on branch <code>beta</code>
        </p>

        <section id="featured">
          <h2>featured snapshots · 0.4.3 and 0.4.3.1</h2>
          <p>
            Compact tables copied from the 0.4.3 and 0.4.3.1 release notes. Each block names its date, card, fixture and
            method, and links the full page, so the figures stay scoped to that measurement, not a lasting claim about
            every hipfire build.
          </p>

          <h3 id="a3b-mq4rs">Qwen3.6 35B-A3B mq4rs · {a3bPrefill.card} · prefill, {a3bPrefill.date}</h3>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>prefill tok/s</th>
                  <th class="num">0.4.2.1 mq4r</th>
                  <th class="num">0.4.3 mq4r</th>
                  <th class="num">0.4.3 mq4rs</th>
                  <th class="num">mq4rs vs 0.4.2.1 mq4r</th>
                </tr>
              </thead>
              <tbody>
                {a3bPrefill.rows.map((r) => (
                  <tr>
                    <td>pp{r.pp}</td>
                    <td class="num">{f0(r.v042_mq4r)}</td>
                    <td class="num">{f0(r.v043_mq4r)}</td>
                    <td class="num"><strong>{f0(r.v043_mq4rs)}</strong></td>
                    <td class="num">{x1(r.speedup)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Radeon AI PRO R9700, <code>hipfire bench --matrix --pp 512,1024,4096,8192,16384 --tg 1 --ctx 1 --runs 3 --warmups 1 --spec off</code>,
            median of 9 samples (3 fresh processes), arms interleaved in one timing hold, {a3bPrefill.date}. “0.4.2” is v0.4.2.1.
            Each version ran its default config and the defaults differ (KV q8 and 512-row chunks on 0.4.2.1; fp8 KV and
            8192-row chunks on 0.4.3), so the mq4r-to-mq4r column is an upgrade comparison, not a single-variable A/B.
            Fast mq4rs prefill is gfx1201 only. Source: <a href={RELEASE_URL}>v0.4.3 release notes</a>; details on the
            <a href="/benchmarks/0.4.3#a3b-prefill">0.4.3 page</a>.
          </p>

          <h3>Qwen3.6 35B-A3B mq4rs · {a3bDecode.card} · decode, 0.4.3.1</h3>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>decode tok/s</th>
                  <th class="num">HIP route (0.4.3)</th>
                  <th class="num">PM4 replay (0.4.3.1)</th>
                  <th class="num">change</th>
                </tr>
              </thead>
              <tbody>
                {a3bDecode.rows.map((r) => (
                  <tr>
                    <td>{r.label}</td>
                    <td class="num">{r.hipTxt}</td>
                    <td class="num"><strong>{r.pm4Txt}</strong></td>
                    <td class="num">+{r.pct} %</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Radeon AI PRO R9700, <code>hipfire bench --spec off --matrix --pp 128 --ctx 128,8192 --tg 128 --runs 3 --warmups 2</code>, default
            config (HIP arm set with <code>replay.backend = "hip"</code>), 3 fresh processes per arm; greedy ids identical
            between routes. gfx1201 only; prefill unaffected. Source: <a href={PATCH_URL}>v0.4.3.1 release notes</a>;
            more detail on the <a href="/benchmarks/0.4.3#a3b-decode">0.4.3 page</a>.
          </p>

          <h3 id="flash-next">Qwen3.8-Flash (Flash-Next) · R9700 prefill and Strix Halo 16K</h3>
          <div class="table-wrap">
            <table class="perf">
              <thead><tr><th>change</th><th>fixture</th><th>result</th></tr></thead>
              <tbody>
                {flashNextRows.map((r) => (
                  <tr>
                    <td>{r.change}</td>
                    <td><span class="muted">{r.hw}</span></td>
                    <td><strong>{r.result}</strong></td>
                  </tr>
                ))}
                <tr>
                  <td>Strix Halo 16K prefill, NPU trunk on</td>
                  <td><span class="muted">Strix Halo + XDNA2 · {f0(halo16k.tokens)}-token prompt · client TTFT · 3 fresh processes × 3 requests · {halo16k.date}</span></td>
                  <td><strong>{halo16k.median.toLocaleString("en-US", { minimumFractionDigits: 1 })} tok/s all-9 median; four steady requests {halo16k.steadyRange}. v0.4.2 shipped tip, an earlier measurement ({halo16k.v042Date}): {f0(halo16k.v042Shipped)} tok/s</strong></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Rows are separate change-level campaigns on different cards and are not chained. Source:
            <a href={RELEASE_URL}>v0.4.3 release notes</a>, Headline numbers. The 16,384-row chunk makes decode 5–10 %
            slower; <code>HIPFIRE_PREFILL_CHUNK_ROWS=4096</code> restores it. The expert hot set, MTP figures published
            with the release notes and the Strix Halo contributor figures are on the
            <a href="/benchmarks/0.4.3">0.4.3 page</a>.
          </p>

          <h2 id="historical">historical snapshots (before 0.4.1)</h2>
          <p>
            The three snapshots below come from the engine's README and perf-checkpoint files and predate the 0.4.1
            release matrix. They are kept as dated evidence of those fixtures, not as current claims, and were not
            re-measured for 0.4.3. In particular the Qwen3.6 35B-A3B row is the <code>mq4r</code> file, not
            <code>{a3bFile.mq4rsTag}</code>, so it is not a baseline for the 0.4.3.1 decode numbers above.
          </p>

          <h3 id="qwen36-mq4r">Qwen3.6 35B-A3B MQ4R · single-GPU AR · historical README snapshot</h3>
          <p>{qwen36Mq4r.method}</p>
          <p class="footnote">
            Historical: an <code>mq4r</code> AR snapshot from the engine README, with no measurement date recorded here, not re-measured
            for 0.4.3. The R9700 row (203.9 tok/s) is a different file from the 0.4.3.1 mq4rs decode figure above; the
            7900 XTX and Strix Halo rows have no 0.4.3 re-measurement.
          </p>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>GPU</th>
                  <th>arch</th>
                  <th class="num">TG128 AR</th>
                  <th class="num">8-turn avg</th>
                  <th class="num">final turn</th>
                </tr>
              </thead>
              <tbody>
                {qwen36Mq4r.rows.map((r) => (
                  <tr>
                    <td>{r.gpu}</td>
                    <td>{r.arch}</td>
                    <td class="num"><strong>{r.tg128Ar.toFixed(1)}</strong> tok/s</td>
                    <td class="num">{r.eightTurnAvg.toFixed(1)} tok/s</td>
                    <td class="num">{r.finalTurn}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Source:
            <a href={qwen36Mq4r.sourceUrl}>{qwen36Mq4r.sourceLabel}</a>
          </p>

          <h3 id="qwen38-mq4v2">
            Qwen3.8-27B MQ4V2 · {qwen38Mq4v2.date} · {qwen38Mq4v2.fixture} · historical
          </h3>
          <p>{qwen38Mq4v2.method}</p>
          <p class="footnote">
            Historical: a {qwen38Mq4v2.date} perf checkpoint on the old XT / Base / Pro product ladder. It is dated
            evidence for that build and fixture, not a current claim, and it predates the 0.4.1 release numbers.
          </p>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>tier</th>
                  <th class="num">AR decode</th>
                  <th class="num">prefill</th>
                  <th class="num">DFlash</th>
                  <th class="num">τ</th>
                  <th class="num">bpw</th>
                </tr>
              </thead>
              <tbody>
                {qwen38Mq4v2.rows.map((r) => (
                  <tr>
                    <td><strong>{r.tier}</strong></td>
                    <td class="num">{r.ar.toFixed(1)} tok/s</td>
                    <td class="num">{r.prefill.toFixed(1)}</td>
                    <td class="num"><strong>{r.dflash.toFixed(1)}</strong> tok/s</td>
                    <td class="num">{r.tau.toFixed(2)}</td>
                    <td class="num">{r.bpw.toFixed(3)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Dated {qwen38Mq4v2.date}. Source:
            <a href={qwen38Mq4v2.sourceUrl}>{qwen38Mq4v2.sourceLabel}</a>
            (<code>{qwen38Mq4v2.sourcePath}</code>)
          </p>

          <h3 id="deepseek-v4">
            DeepSeek V4 Flash MQ2R · {deepseekV4FlashMq2r.fixture} · historical
          </h3>
          <p>{deepseekV4FlashMq2r.method}</p>
          <p class="footnote">Historical README snapshot, not re-measured for 0.4.3.</p>
          <div class="table-wrap">
            <table class="perf">
              <thead>
                <tr>
                  <th>topology</th>
                  <th class="num">decode</th>
                  <th class="num">prefill</th>
                </tr>
              </thead>
              <tbody>
                {deepseekV4FlashMq2r.rows.map((r) => (
                  <tr>
                    <td><strong>{r.topology}</strong></td>
                    <td class="num"><strong>{r.decode.toFixed(1)}</strong> tok/s</td>
                    <td class="num">{r.prefill} tok/s</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="footnote">
            Source:
            <a href={deepseekV4FlashMq2r.sourceUrl}>{deepseekV4FlashMq2r.sourceLabel}</a>
          </p>
        </section>

        <h2 id="live-ledger">live localmaxxing ledger</h2>
        <p>
          Architecture tables below are approved community runs pulled at this
          site build. They are a separate surface from the featured
          snapshots above — different harness, different fixtures. Do not treat
          a live cell and a dated snapshot as the same measurement.
        </p>

        {sortedArchs.map((arch) => {
          const cells = buckets.get(arch) ?? [];
          return (
            <section id={arch}>
              <h2>{arch} <span class="cell-sub">— {archGen(arch)}</span></h2>
              <div class="table-wrap">
                <table class="perf">
                  <thead>
                    <tr>
                      <th>hardware</th>
                      <th>model</th>
                      <th>q</th>
                      <th>mode</th>
                      <th class="num">decode tok/s</th>
                      <th class="num">prefill</th>
                      <th class="num">AR base</th>
                      <th class="num">× AR</th>
                      <th class="num">τ</th>
                      <th>run</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cells.map((r) => {
                      const np = parseNotes(r.notes);
                      const mode = modeOf(r);
                      return (
                        <tr>
                          <td>{hardwareLabel(r)}</td>
                          <td>{r.model.displayName}</td>
                          <td><code>{r.engine.quantization}</code></td>
                          <td>{mode}</td>
                          <td class="num"><strong>{fmtNum(r.tokSOut)}</strong></td>
                          <td class="num">{fmtInt(r.tokSPrefill)}</td>
                          <td class="num">{np.arBaseline ? fmtNum(np.arBaseline) : "—"}</td>
                          <td class="num accent">{np.speedup ? `${np.speedup.toFixed(2)}×` : "—"}</td>
                          <td class="num">{np.tau ? np.tau.toFixed(2) : "—"}</td>
                          <td><a href={`https://localmaxxing.com/runs/${r.id}`}><code class="cell-sub">{r.id.slice(0, 10)}…</code></a></td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              {cells.length > 0 && (
                <p class="footnote">
                  Engine: <code>{cells[0].engine.engineName}@{cells[0].engine.engineVersion}</code> &middot;
                  Submitter: @{cells[0].user.username}
                </p>
              )}
            </section>
          );
        })}

        <h2 id="methodology">methodology</h2>
        <p>
          Live localmaxxing cells follow a shared protocol so cross-arch
          comparisons inside that harness are meaningful. Featured
          snapshots use the method notes printed beside each table — those
          fixtures are not interchangeable with the live ledger.
        </p>
        <ul>
          <li><strong>Prompt</strong>: <code>benchmarks/prompts/merge_sort_thinking_off.txt</code>, md5 <code>253c7ac50857fe6d0e10fb0d2c5e35c0</code>, 27 input tokens. One newline-shape variant locks in a stable τ across runs. Source tree: <a href={`${ENGINE_REPO_BLOB}/benchmarks/prompts/merge_sort_thinking_off.txt`}>warpfront/hipfire</a>.</li>
          <li><strong>Config</strong>: <code>--max 256 --temp 0.0 --no-chatml --kv-mode q8 --ctx 4096</code>, <code>prompt_normalize=on</code> (default since 2026-04-26).</li>
          <li><strong>Runs</strong>: one <code>--max 16</code> warmup per cell (discarded), then 3 timed runs at <code>--max 256</code>, median reported. AR baseline is a paired <code>--ar-baseline</code> run from the same binary on the same hardware.</li>
          <li><strong>Coherence</strong>: every submitted run produced readable <code>merge_sort</code> code &mdash; no attractors, token loops, or special-token leaks.</li>
          <li><strong>GPU isolation</strong>: <code>HIP_VISIBLE_DEVICES</code> per cell on hosts with multiple GPUs; no two cells share a GPU concurrently.</li>
        </ul>
        <p>
          Why this matters: a <strong>single newline change</strong> in the
          prompt can swing τ by 17% on 27B DFlash &mdash; same model, same
          flags, different token sequence. The prompt md5 is part of the
          claim.
        </p>
        <p>
          Engine docs and performance checkpoints live in
          <a href={ENGINE_REPO_TREE}>warpfront/hipfire</a> (current release v0.4.3.1; optimization continues on
          <code>beta</code>) — see
          <a href={`${ENGINE_REPO_TREE}/docs`}>docs/</a> and
          <a href={`${ENGINE_REPO_TREE}/docs/perf-checkpoints`}>docs/perf-checkpoints/</a>.
        </p>

        <h2 id="reproducibility">reproducibility</h2>
        <p>Every live row carries the exact launch command in its localmaxxing notes. To repro any cell:</p>
        <pre class="code"><span class="prompt">$</span> hipfire pull <span class="str">&lt;model&gt;</span>

<span class="prompt">$</span> hipfire bench <span class="str">&lt;model&gt;</span> --spec dflash --runs 5 --warmups 3 \
    --max-tokens 256 --backend noslots --workload stateless --json</pre>
        <p>
          Prefer <code>hipfire bench</code> over <code>examples/dflash_spec_demo</code>:
          the demo runs raw open-ended continuation and under-reports by ~40%
          because it never hits the chatml + structured-thinking serve path
          (see <a href={`${ENGINE_REPO_BLOB}/AGENTS.md`}>AGENTS.md</a>).
        </p>
        <p>
          For DFlash, the draft model is hosted at
          <a href="https://huggingface.co/z-lab/Qwen3.5-9B-DFlash">z-lab/Qwen3.5-9B-DFlash</a>
          and
          <a href="https://huggingface.co/z-lab/Qwen3.5-27B-DFlash">z-lab/Qwen3.5-27B-DFlash</a>.
          The native-head MQ4 conversion is shipped with hipfire's draft pulls
          (<code>hipfire pull qwen3.5:9b-dflash</code>).
        </p>

        <h2 id="submit-your-own">submit your own</h2>
        <p>
          Anyone with a hipfire build can submit. Install
          <code>lmx-bench</code> for a curated harness, or POST directly to
          <code>localmaxxing.com/api/benchmarks</code> with the schema from
          <a href="https://localmaxxing.com/en/api-docs">the API docs</a>.
          See an existing row's <code>engineFlags.commandSnippet</code> for the
          exact invocation to mirror. Build from
          <a href={ENGINE_REPO_TREE}>warpfront/hipfire</a> (the release tag, or <code>beta</code> for in-progress work).
        </p>
      </article>
    </main>
  </div>
</Base>
