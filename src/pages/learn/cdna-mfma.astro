<script>
  // ─────────── latency-hiding animation ───────────
  (() => {
    const widget = document.querySelector('[data-widget="latency-hiding"]');
    if (!widget) return;

    // schedule: per-wavefront, per-tick state.
    // 16 ticks, 3 wavefronts. WF A starts running, stalls, resumes.
    // While A stalls the scheduler runs B then C — CU stays busy throughout.
    const TICKS = 16;
    const sched: Record<"A" | "B" | "C", Array<"run" | "stall" | "idle">> = {
      A: ["run","run","run","run","stall","stall","stall","stall","stall","stall","stall","stall","run","run","run","run"],
      B: ["idle","idle","idle","idle","run","run","run","run","run","run","run","run","idle","idle","idle","idle"],
      C: ["idle","idle","idle","idle","idle","idle","idle","idle","run","run","run","run","run","run","run","run"],
    };
    const statusOf = (s: "run" | "stall" | "idle"): string =>
      s === "run" ? "running" : s === "stall" ? "stalled on HBM" : "queued";

    const tracks: Record<"A" | "B" | "C", HTMLElement> = {
      A: document.getElementById("lh-track-A")!,
      B: document.getElementById("lh-track-B")!,
      C: document.getElementById("lh-track-C")!,
    };
    const statuses: Record<"A" | "B" | "C", HTMLElement> = {
      A: document.getElementById("lh-status-A")!,
      B: document.getElementById("lh-status-B")!,
      C: document.getElementById("lh-status-C")!,
    };
    const cuState = document.getElementById("lh-cu-state")!;
    if (!tracks.A || !tracks.B || !tracks.C || !statuses.A || !cuState) return;

    // build cells once
    (["A", "B", "C"] as const).forEach((wf) => {
      tracks[wf].innerHTML = "";
      for (let i = 0; i < TICKS; i++) {
        const cell = document.createElement("div");
        cell.className = "lh-cell";
        cell.dataset.state = sched[wf][i];
        tracks[wf].appendChild(cell);
      }
    });

    let tick = 0;
    let paused = false;
    const pauseBtn = document.getElementById("lh-pause");

    const render = () => {
      (["A", "B", "C"] as const).forEach((wf) => {
        const cells = tracks[wf].children;
        for (let i = 0; i < TICKS; i++) {
          (cells[i] as HTMLElement).classList.toggle("active", i === tick);
          (cells[i] as HTMLElement).classList.toggle("past", i < tick);
        }
        const s = sched[wf][tick];
        statuses[wf].textContent = statusOf(s);
        statuses[wf].dataset.state = s;
      });
      const anyRun = (["A", "B", "C"] as const).some((wf) => sched[wf][tick] === "run");
      cuState.textContent = `CU: ${anyRun ? "busy" : "idle"}`;
      cuState.classList.toggle("busy", anyRun);
      cuState.classList.toggle("idle", !anyRun);
    };

    const step = () => {
      if (!paused) {
        tick = (tick + 1) % TICKS;
        render();
      }
    };
    render();
    let timer = window.setInterval(step, 350);

    pauseBtn?.addEventListener("click", () => {
      paused = !paused;
      if (pauseBtn) pauseBtn.textContent = paused ? "play" : "pause";
    });

    // pause when off-screen (save battery)
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) {
            window.clearInterval(timer);
            timer = 0;
          } else if (!timer) {
            timer = window.setInterval(step, 350);
          }
        });
      }, { threshold: 0.1 });
      io.observe(widget);
    }
  })();

  // ─────────── MFMA tile animation ───────────
  (() => {
    const widget = document.querySelector('[data-widget="mfma"]');
    if (!widget) return;

    const variants: Record<string, { dim: number; aType: string; bType: string; cType: string; label: string }> = {
      f16_16x16: { dim: 8, aType: "fp16", bType: "fp16", cType: "fp32", label: "~256 fp16 MACs per cycle, per CU" },
      bf16_32x32:{ dim: 10, aType: "bf16", bType: "bf16", cType: "fp32", label: "32×32×8 bf16 tile — wider, fewer issues" },
      fp8:       { dim: 8, aType: "fp8",  bType: "fp8",  cType: "fp32", label: "FP8 (CDNA 3+): 2× throughput vs fp16" },
    };

    const tileIds = ["mfma-A", "mfma-B", "mfma-C", "mfma-D"] as const;
    let issue = 0;
    let raf: number | null = null;
    let lastTime = 0;
    let phase = 0; // 0..1 cycle progress
    const PHASE_MS = 1600;
    let activeVariant = "f16_16x16";

    const counter = document.getElementById("mfma-issue-counter");
    const issueLabel = widget.querySelector(".mfma-issue-label") as HTMLElement | null;

    const buildTiles = () => {
      const v = variants[activeVariant];
      const dim = v.dim;
      tileIds.forEach((id, idx) => {
        const grid = document.getElementById(id);
        if (!grid) return;
        grid.innerHTML = "";
        grid.style.setProperty("--mfma-dim", String(dim));
        for (let r = 0; r < dim; r++) {
          for (let c = 0; c < dim; c++) {
            const cell = document.createElement("div");
            cell.className = "mfma-cell";
            cell.dataset.r = String(r);
            cell.dataset.c = String(c);
            cell.dataset.tile = String(idx);
            grid.appendChild(cell);
          }
        }
      });
      const dtypes = widget.querySelectorAll(".mfma-dtype");
      if (dtypes[0]) dtypes[0].textContent = v.aType;
      if (dtypes[1]) dtypes[1].textContent = v.bType;
      if (dtypes[2]) dtypes[2].textContent = v.cType;
      if (dtypes[3]) dtypes[3].textContent = v.cType;
      if (issueLabel) issueLabel.textContent = v.label;
    };

    const render = () => {
      const v = variants[activeVariant];
      const dim = v.dim;
      // For an MFMA: every output D[i][j] uses the entire row i of A + col j of B + scalar C[i][j].
      // We sweep a diagonal wave across i+j, lighting up the corresponding lane in each tile.
      const sweep = phase * (dim + dim);
      tileIds.forEach((id, tileIdx) => {
        const grid = document.getElementById(id);
        if (!grid) return;
        const cells = grid.children;
        for (let i = 0; i < cells.length; i++) {
          const cell = cells[i] as HTMLElement;
          const r = parseInt(cell.dataset.r || "0", 10);
          const c = parseInt(cell.dataset.c || "0", 10);
          const wave = r + c;
          const dist = Math.abs(wave - sweep);
          const heat = Math.max(0, 1 - dist / 2.5);
          if (tileIdx === 3) {
            // D: cumulative — once swept, stay lit
            cell.classList.toggle("filled", wave <= sweep);
            cell.style.setProperty("--heat", String(heat));
          } else {
            cell.style.setProperty("--heat", String(heat));
            cell.classList.toggle("filled", false);
          }
        }
      });
    };

    const loop = (t: number) => {
      if (!lastTime) lastTime = t;
      const dt = t - lastTime;
      lastTime = t;
      phase += dt / PHASE_MS;
      if (phase >= 1) {
        phase = 0;
        issue += 1;
        if (counter) counter.textContent = String(issue);
      }
      render();
      raf = requestAnimationFrame(loop);
    };

    buildTiles();
    raf = requestAnimationFrame(loop);

    // variant picker
    widget.querySelectorAll<HTMLButtonElement>(".mfma-variant").forEach((btn) => {
      btn.addEventListener("click", () => {
        widget.querySelectorAll(".mfma-variant").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeVariant = btn.dataset.variant || "f16_16x16";
        phase = 0;
        issue = 0;
        if (counter) counter.textContent = "1";
        buildTiles();
      });
    });

    // pause off-screen
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting && raf) {
            cancelAnimationFrame(raf);
            raf = null;
            lastTime = 0;
          } else if (e.isIntersecting && !raf) {
            raf = requestAnimationFrame(loop);
          }
        });
      }, { threshold: 0.1 });
      io.observe(widget);
    }
  })();
</script>
