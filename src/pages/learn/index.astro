---
import LearnLayout from "../../components/learn/LearnLayout.astro";
import { decks, tagTree, RELEASE_URL } from "../../data/learn";

const description =
  "Teaching pages on how hipfire runs LLMs on AMD GPUs: speculative decoding on RDNA, PeaceMaker certified kernels, the session cache, tokenizer fidelity, MagnumQuant, QSA sparse attention, and the RDNA / CDNA matrix units. Numbers are from the 0.4.1 release.";

const release = decks.filter((d) => d.group === "release");
const silicon = decks.filter((d) => d.group === "silicon");
---

<LearnLayout title="learn" description={description}>
  <main>
    <section class="hero hero-distil">
      <div class="hero-eyebrow">/learn &middot; hipfire 0.4.1</div>
      <h1 class="hero-tagline">How hipfire runs LLMs on AMD GPUs.</h1>
      <p class="hero-sub">
        Each page explains one idea, shows how hipfire implements it (with links
        into the <code>v0.4.1</code> source), and says what it measured in the
        0.4.1 release on Strix Halo and the Radeon AI PRO R9700. Nothing here is
        projected or borrowed from another engine.
      </p>
      <div class="hero-bullets">
        <span>native MTP</span>
        <span>PeaceMaker</span>
        <span>session cache</span>
        <span>FWHT quantization</span>
        <span>sparse attention</span>
        <span>WMMA &middot; MFMA</span>
      </div>
    </section>

    <section class="section section-narrow">
      <h2 class="lx-group-title">inside 0.4.1</h2>
      <div class="distil-deck-list">
        {release.map((d) => (
          <a class="distil-card" href={d.href}>
            <div class="distil-card-tag">{d.tag}</div>
            <h3 class="distil-card-title">{d.title}</h3>
            <p class="distil-card-sub">{d.sub}</p>
          </a>
        ))}
      </div>

      <h2 class="lx-group-title">the silicon underneath</h2>
      <div class="distil-deck-list">
        {silicon.map((d) => (
          <a class="distil-card" href={d.href}>
            <div class="distil-card-tag">{d.tag}</div>
            <h3 class="distil-card-title">{d.title}</h3>
            <p class="distil-card-sub">{d.sub}</p>
          </a>
        ))}
      </div>
      <p class="footnote">
        Measured figures on these pages come from the
        <a href={RELEASE_URL}>v0.4.1 release notes</a>, with the hardware and
        protocol named next to each number. Hardware specifications cite AMD.
      </p>
    </section>

    <section class="section section-narrow">
      <h2>two GPU families, one engine</h2>
      <p class="lede">
        Same HIP source, two different machines. The silicon pages walk each
        row of this table.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th></th>
              <th>CDNA &mdash; Instinct</th>
              <th>RDNA &mdash; Radeon / Ryzen AI</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>wavefront</strong></td><td>64 threads</td><td>32 threads</td></tr>
            <tr><td><strong>matrix unit</strong></td><td><code>v_mfma_*</code></td><td><code>v_wmma_*</code> (RDNA3 and later)</td></tr>
            <tr><td><strong>memory</strong></td><td>HBM</td><td>GDDR6, or shared LPDDR5X on Strix Halo</td></tr>
            <tr><td><strong>LLVM targets hipfire knows</strong></td><td><code>gfx908</code>, <code>gfx940&ndash;gfx942</code> (plus Vega <code>gfx906</code>)</td><td><code>gfx1010</code> &rarr; <code>gfx1201</code></td></tr>
            <tr><td><strong>hipfire kernels</strong></td><td>portable wave64 path; MFMA through rocBLAS on CDNA3</td><td>architecture-tuned WMMA kernels on gfx11 / gfx12</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section-narrow">
      <h2>related reading</h2>
      <ul class="doclinks">
        <li><a href="/docs/architecture">/docs/architecture</a> &mdash; the engine layout these pages describe</li>
        <li><a href="/docs/quantization">/docs/quantization</a> &mdash; weight and KV formats</li>
        <li><a href={RELEASE_URL}>v0.4.1 release notes</a> &mdash; every measured number, with its build and protocol</li>
        <li><a href={tagTree()}>github.com/warpfront/hipfire @ v0.4.1</a> &mdash; engine source</li>
      </ul>
    </section>
  </main>
</LearnLayout>
