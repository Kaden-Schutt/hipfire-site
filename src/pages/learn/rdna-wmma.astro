              <div class="mfma-tile-label">C &middot; <span class="mfma-dtype">fp32</span> &middot; accumulator</div>
            </div>
            <div class="mfma-op">=</div>
            <div class="mfma-tile" data-tile="D">
              <div class="mfma-tile-grid" id="wmma-D"></div>
              <div class="mfma-tile-label">D &middot; <span class="mfma-dtype">fp32</span> &middot; result</div>
            </div>
          </div>
          <div class="wmma-lanes">
            <span class="wmma-lanes-label">wave32 lanes contributing:</span>
            <div class="wmma-lane-strip" id="wmma-lane-strip"></div>
          </div>
          <div class="wmma-k-progress" aria-hidden="true">
            <span class="wmma-k-label">K-loop iteration</span>
            <div class="wmma-k-strip" id="wmma-k-strip"></div>
