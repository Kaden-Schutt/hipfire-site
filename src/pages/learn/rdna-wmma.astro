            </g>
            <g class="gen-break">
              <line x1="660" y1="40" x2="660" y2="305" stroke="#e11d2a" stroke-dasharray="3 3" stroke-width="1" opacity="0.45"/>
              <text x="664" y="48" class="gen-break-txt">WMMA32 + 1.5× regs</text>
            </g>

            <!-- stations: 5 archs evenly spaced (160px gap from x=100 to x=740) -->
            <g class="gen-station" data-i="0" data-x="100">
              <circle cx="100" cy="320" r="9" class="gen-node"/>
