              <text x="580" y="348" class="gen-arch">RDNA3.5</text>
              <text x="580" y="364" class="gen-gfx">gfx1151</text>
              <g class="gen-features">
                <rect x="540" y="270" width="80" height="22" class="gen-feat" data-tier="scalar"/>
                <text x="580" y="285" class="gen-feat-txt">scalar</text>
                <rect x="540" y="242" width="80" height="22" class="gen-feat" data-tier="dp4a"/>
                <text x="580" y="257" class="gen-feat-txt">dp4a</text>
                <rect x="540" y="214" width="80" height="22" class="gen-feat" data-tier="dot2"/>
                <text x="580" y="229" class="gen-feat-txt">dot2 fp16</text>
                <rect x="540" y="148" width="80" height="56" class="gen-feat gen-feat-flag" data-tier="wmma"/>
                <text x="580" y="172" class="gen-feat-txt gen-feat-txt-flag">v_wmma_*</text>
                <text x="580" y="190" class="gen-feat-txt-sub">APU / iGPU</text>
              </g>
            </g>

            <g class="gen-station" data-i="4" data-x="740">
              <circle cx="740" cy="320" r="9" class="gen-node"/>
              <text x="740" y="348" class="gen-arch">RDNA4</text>
              <text x="740" y="364" class="gen-gfx">gfx1201</text>
              <g class="gen-features">
                <rect x="700" y="270" width="80" height="22" class="gen-feat" data-tier="scalar"/>
                <text x="740" y="285" class="gen-feat-txt">scalar</text>
