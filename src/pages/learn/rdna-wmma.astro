                <stop offset="40%"  stop-color="#e11d2a" stop-opacity="0.55"/>
                <stop offset="100%" stop-color="#e11d2a" stop-opacity="0.95"/>
              </linearGradient>
              <!-- Leftward trail: mirrored — opaque at start, transparent at end -->
              <linearGradient id="gen-trail-grad-rev" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%"   stop-color="#e11d2a" stop-opacity="0.95"/>
                <stop offset="60%"  stop-color="#e11d2a" stop-opacity="0.55"/>
                <stop offset="100%" stop-color="#e11d2a" stop-opacity="0"/>
              </linearGradient>
              <radialGradient id="gen-dot-glow" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0%"   stop-color="#e11d2a" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#e11d2a" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <!-- baseline track -->
            <line x1="80" y1="320" x2="820" y2="320" stroke="#2a2a2a" stroke-width="2"/>

            <!-- structural break annotations (behind everything) -->
