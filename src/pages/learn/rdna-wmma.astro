<script>
  // ─────────── occupancy explorer ───────────
  (() => {
    const widget = document.getElementById("occ-widget");
    if (!widget) return;
    const input = document.getElementById("occ-input") as HTMLInputElement | null;
    const val   = document.getElementById("occ-val");
    const valR3 = document.getElementById("occ-val-rdna3");
    const valR4 = document.getElementById("occ-val-rdna4");
    const barR3 = document.getElementById("occ-bar-rdna3");
    const barR4 = document.getElementById("occ-bar-rdna4");
    const verdict = document.getElementById("occ-verdict");
    if (!input || !val || !valR3 || !valR4 || !barR3 || !barR4 || !verdict) return;

    // step function from the published RDNA wave32 table
    const occRdna3 = (vgpr: number): number => {
      if (vgpr <=  64) return 16;
      if (vgpr <=  84) return 12;
      if (vgpr <=  96) return 10;
      if (vgpr <= 112) return  9;
      if (vgpr <= 128) return  8;
      if (vgpr <= 168) return  6;
      if (vgpr <= 204) return  5;
      return 4;
    };
    const occRdna4 = (vgpr: number): number => {
      if (vgpr <=  96) return 16;
      if (vgpr <= 112) return 13;
      if (vgpr <= 128) return 12;
      if (vgpr <= 168) return  9;
      if (vgpr <= 204) return  7;
      return 6;
    };

    const verdictFor = (vgpr: number, r3: number, r4: number): string => {
      if (vgpr <= 64)  return `Light kernel (≤64 VGPRs): <strong>both archs at max occupancy.</strong>`;
      if (vgpr <= 96)  return `Typical WMMA fused GEMM (~96 VGPRs/wave): <strong>RDNA4 keeps full occupancy; RDNA3 loses ${16 - r3} waves/SIMD.</strong>`;
      if (vgpr <= 128) return `Heavy kernel (~${vgpr} VGPRs): <strong>RDNA3 occupancy collapses to ${r3}; RDNA4's 1.5× VGPR file holds ${r4}.</strong>`;
      if (vgpr <= 204) return `Register-hungry path (~${vgpr} VGPRs): <strong>${r3} vs ${r4} waves/SIMD &mdash; expect VALUBusy gains on RDNA4.</strong>`;
      return `Spill territory (~${vgpr} VGPRs): <strong>only ${r3}/${r4} waves/SIMD &mdash; rewrite or split the kernel.</strong>`;
    };

    const update = () => {
      const vgpr = parseInt(input.value, 10);
      const r3 = occRdna3(vgpr);
      const r4 = occRdna4(vgpr);
      val.textContent = String(vgpr);
      valR3.textContent = String(r3);
      valR4.textContent = String(r4);
      // 16 = max occupancy. Bar width as % of full.
      barR3.style.width = `${(r3 / 16) * 100}%`;
      barR4.style.width = `${(r4 / 16) * 100}%`;
      verdict.innerHTML = verdictFor(vgpr, r3, r4);
    };

    input.addEventListener("input", update);
    update();
  })();

  // ─────────── dispatch tree ───────────
  (() => {
    const widget = document.querySelector('[data-widget="dispatch"]');
    if (!widget) return;
    const buttons = widget.querySelectorAll<HTMLButtonElement>(".dispatch-arch");
    const branches = widget.querySelectorAll<HTMLElement>(".dispatch-branch");
    const verdict = document.getElementById("dispatch-verdict");
    if (!verdict) return;

    const archToBranch: Record<string, { branch: string; kernel: string; ceiling: string }> = {
      gfx1010: { branch: "baseline", kernel: "scalar baseline",    ceiling: "no matrix unit, no dp4a"          },
      gfx1030: { branch: "dot2",     kernel: "dot2 path",          ceiling: "v_dot2_f32_f16 packed FMA"        },
      gfx1100: { branch: "gfx11",    kernel: "WMMA16 path",        ceiling: "~123 TFLOPs ceiling"              },
      gfx1151: { branch: "gfx11",    kernel: "WMMA16 path",        ceiling: "shared system RAM, 5× prefill win" },
      gfx1201: { branch: "gfx12",    kernel: "WMMA32 path",        ceiling: "32-wide tiles + 1.5× VGPR file"   },
    };

    const select = (arch: string) => {
      const target = archToBranch[arch];
      if (!target) return;
      buttons.forEach((b) => {
        const on = b.dataset.arch === arch;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", String(on));
      });
      branches.forEach((br) => {
        br.classList.toggle("active", br.dataset.branch === target.branch);
        br.classList.toggle("dimmed", br.dataset.branch !== target.branch);
      });
      verdict.innerHTML = `<strong>${arch}</strong> takes the <strong>${target.kernel}</strong> &mdash; ${target.ceiling}.`;
    };

    buttons.forEach((b) => {
      b.addEventListener("click", () => {
        const arch = b.dataset.arch;
        if (arch) select(arch);
      });
    });

    // initialize
    select("gfx1100");
  })();

  // ─────────── generations timeline (ping-pong tracer with varied pacing) ───────────
  (() => {
    const widget = document.querySelector('[data-widget="gen-timeline"]');
    if (!widget) return;
    const trail = widget.querySelector("#gen-trail") as SVGLineElement | null;
    const glow = widget.querySelector("#gen-glow") as SVGCircleElement | null;
    const dot = widget.querySelector("#gen-tracer-dot") as SVGCircleElement | null;
    const detail = widget.querySelector("#gen-detail") as HTMLElement | null;
    const stations = widget.querySelectorAll<SVGGElement>(".gen-station");
    if (!trail || !glow || !dot || !detail || !stations.length) return;

    const stationXs = Array.from(stations).map((s) => parseInt(s.dataset.x || "0", 10));
    type StationInfo = { arch: string; text: string };
    const stationInfo: StationInfo[] = [
      { arch: "RDNA1 (gfx1010)",   text: "No matrix unit, no dp4a. Scalar fma only — the floor of the perf envelope. 5700 XT decode lives here." },
      { arch: "RDNA2 (gfx1030)",   text: "First dp4a (v_dot4_i32_i8). +1.72× over RDNA1 on prefill from packed-int dot — but still no matrix tile." },
      { arch: "RDNA3 (gfx1100)",   text: "First gen with the WMMA matrix unit. 16×16 fp16 tile per issue, ~123 TFLOPs theoretical. A historical cross-arch fixture reported 2.94× higher prefill." },
      { arch: "RDNA3.5 (gfx1151)", text: "Strix Halo APU. Same wave32 + WMMA shape; shared system RAM makes prefill the opportunity and decode the trade." },
      { arch: "RDNA4 (gfx1201)",   text: "WMMA32 — 32-wide tiles. 1.5× the VGPR file per SIMD, 2× LDS per CU. Most kernels need a .gfx12.hip variant to actually realize the new ceiling." },
    ];

    // Per-segment travel time (ms) and per-station dwell time (ms).
    // Slower across structural breaks (RDNA2 → RDNA3 = matrix unit; RDNA3.5 → RDNA4 = WMMA32);
    // longer dwell on the gens that actually introduce something new.
    const segMs:    number[] = [ 700, 1500, 700, 1500 ]; // 0→1, 1→2, 2→3, 3→4
    const dwellMs:  number[] = [ 500, 800, 1500, 700, 1500 ]; // per station

    type Mode = "dwelling" | "moving";
    let mode: Mode = "dwelling";
    let segIdx = 0;     // current segment (when moving) or station (when dwelling)
    let direction = 1;  // +1 (rightward) or -1 (leftward)
    let phaseStart = performance.now();
    let userPicked = false;
    let raf = 0;

    // Detail card: updates which station's copy is shown. Independent of which station node is .active.
    const setDetail = (i: number) => {
      const info = stationInfo[i];
      detail.innerHTML = `<span class="gen-detail-arch">${info.arch}</span><span class="gen-detail-text">${info.text}</span>`;
    };

    // Station highlight: only ONE station is .active at a time, and only during dwell.
    // During movement, no station is .active — the moving dot is the sole marker.
    const setActiveStation = (i: number | null) => {
      stations.forEach((s, j) => s.classList.toggle("active", i !== null && j === i));
    };

    const TRAIL_LEN = 130; // SVG units of trail length

    const drawTracer = (x: number, dir: number) => {
      dot.setAttribute("cx", String(x));
      glow.setAttribute("cx", String(x));
      if (mode === "dwelling" || dir === 0) {
        // No trail while parked
        trail.setAttribute("opacity", "0");
        return;
      }
      // Comet trail extends BEHIND the dot, opaque at the dot, fading toward the tail.
      // Going right: tail extends to the left  (x1 = x - 130, x2 = x). gen-trail-grad fades 0→100% L→R, opaque end at x2 ✓.
      // Going left:  tail extends to the right (x1 = x + 130, x2 = x). The same gradient runs L→R, which would put the opaque
      // end on the WRONG side (away from the dot). Use the reverse-flavored grad in that case.
      const tailStart = x - dir * TRAIL_LEN;
      trail.setAttribute("x1", String(tailStart));
      trail.setAttribute("x2", String(x));
      trail.setAttribute("stroke", dir > 0 ? "url(#gen-trail-grad)" : "url(#gen-trail-grad-rev)");
      trail.setAttribute("opacity", "1");
    };

    const tick = (t: number) => {
      if (!userPicked) {
        const elapsed = t - phaseStart;
        if (mode === "dwelling") {
          // Sitting on station segIdx (0..4). Hold for dwellMs[segIdx].
          const x = stationXs[segIdx];
          drawTracer(x, direction);
          if (elapsed >= dwellMs[segIdx]) {
            // Decide direction — flip at the ends.
            if (segIdx === stationXs.length - 1) direction = -1;
            else if (segIdx === 0)               direction = 1;
            // Transition to moving: clear the active station so it doesn't linger as a second marker.
            setActiveStation(null);
            mode = "moving";
            phaseStart = t;
          }
        } else {
          // Moving along a segment. When direction is +1, traveling segIdx → segIdx+1.
          const fromIdx = segIdx;
          const toIdx   = segIdx + direction;
          const segDur  = direction > 0 ? segMs[fromIdx] : segMs[toIdx];
          const phase   = Math.min(1, elapsed / segDur);
          const eased   = phase < 0.5 ? 2 * phase * phase : 1 - Math.pow(-2 * phase + 2, 2) / 2;
          const x = stationXs[fromIdx] + (stationXs[toIdx] - stationXs[fromIdx]) * eased;
          drawTracer(x, direction);
          if (phase >= 1) {
            segIdx = toIdx;
            mode = "dwelling";
            phaseStart = t;
            // Arrival: highlight the new station + update the detail card.
            setActiveStation(segIdx);
            setDetail(segIdx);
          }
        }
      }
      raf = requestAnimationFrame(tick);
    };

    stations.forEach((s, i) => {
      s.style.cursor = "pointer";
      s.addEventListener("click", () => {
        userPicked = true;
        mode = "dwelling";
        segIdx = i;
        const x = stationXs[i];
        drawTracer(x, 0);
        trail.setAttribute("opacity", "0");
        setActiveStation(i);
        setDetail(i);
      });
    });

    // initial state: RDNA3, dwelling
    segIdx = 2;
    setActiveStation(2);
    setDetail(2);
    raf = requestAnimationFrame(tick);

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          } else if (e.isIntersecting && !raf) {
            phaseStart = performance.now();
            raf = requestAnimationFrame(tick);
          }
        });
      }, { threshold: 0.1 });
      io.observe(widget);
    }
  })();

  // ─────────── WMMA tile animation: K-loop accumulation ───────────
  // Each "issue" = one WMMA instruction = computes a full M×N output tile.
  // We walk through the K-loop step by step (k=0..K-1):
  //   - A: highlight COLUMN k (the data being multiplied this step)
  //   - B: highlight ROW k    (paired with A column k)
  //   - C: existing accumulator (constant glow throughout the issue)
  //   - D: progressively fills as accumulation proceeds; reaches "full" at k=K-1
  // K=16 for RDNA3 WMMA, K=32 for RDNA4 WMMA32 — so WMMA32 issues take longer
  // visibly, exactly the throughput difference users should feel.
  (() => {
    const widget = document.querySelector('[data-widget="wmma"]');
    if (!widget) return;

    type Variant = {
      gridDim: number;     // SVG grid cells per side (visual symbol of 16/32)
      kIters: number;      // K-loop length (matches the *real* K, displayed in counter)
      iterMs: number;      // wall-clock per K iteration
      aType: string; bType: string; cType: string;
      dimLabel: string;    // tile size shown in tile captions
      accent: string;      // CSS color for this variant's heat
      info: { tile: string; dtype: string; ops: string; peak: string; notes: string; };
    };
    const variants: Record<string, Variant> = {
      wmma_f16_16: {
        gridDim: 8, kIters: 16, iterMs: 130,
        aType: "fp16", bType: "fp16", cType: "fp32",
        dimLabel: "16×16", accent: "#e11d2a",
        info: {
          tile:  "M=16, N=16, K=16",
          dtype: "fp16 × fp16 → fp32 accumulator",
          ops:   "256 fma per issue · 16-element dot product per output cell",
          peak:  "~123 TFLOPs · 7900 XTX (gfx1100)",
          notes: "Default WMMA path on RDNA3. Training-class precision; used by hipfire's gemm_qkv_hfq4g256_wmma.hip.",
        },
      },
      wmma_bf16_16: {
        gridDim: 8, kIters: 16, iterMs: 130,
        aType: "bf16", bType: "bf16", cType: "fp32",
        dimLabel: "16×16", accent: "#f97316",
        info: {
          tile:  "M=16, N=16, K=16",
          dtype: "bf16 × bf16 → fp32 accumulator",
          ops:   "256 fma per issue · same instruction rate as fp16",
          peak:  "~123 TFLOPs · 7900 XTX (gfx1100)",
          notes: "Same throughput as fp16, but wider exponent range — preferred for training-style numerics.",
        },
      },
      wmma_i8_16: {
        gridDim: 8, kIters: 16, iterMs: 90,
        aType: "i8", bType: "i8", cType: "i32",
        dimLabel: "16×16", accent: "#fbbf24",
        info: {
          tile:  "M=16, N=16, K=16",
          dtype: "i8 × i8 → i32 accumulator",
          ops:   "256 dot per issue · packed 4×i8 into a 32-bit lane",
          peak:  "~246 TOPs · 7900 XTX (gfx1100)  — 2× the fp16 throughput",
          notes: "Quantized-inference path: matches what hipfire's HFQ4 / MQ4 kernels emit.",
        },
      },
      wmma32: {
        gridDim: 12, kIters: 32, iterMs: 100,
        aType: "fp16", bType: "fp16", cType: "fp32",
        dimLabel: "16×16 · K=32", accent: "#e11d2a",
        info: {
          tile:  "M=16, N=16, K=32  (K doubles vs RDNA3)",
          dtype: "fp16 × fp16 → fp32 accumulator",
          ops:   "512 fma per issue · 32-element dot, 2× MACs per instruction",
          peak:  "~256 TFLOPs · 9070 XT (gfx1201)",
          notes: "RDNA4 only. Also benefits from 1.5× VGPR file → higher occupancy at the same kernel pressure.",
        },
      },
    };

    const tileIds = ["wmma-A", "wmma-B", "wmma-C", "wmma-D"] as const;
    let issue = 1;
    let raf: number | null = null;
    let activeVariant = "wmma_f16_16";
    let phaseStart = 0;

    // Per-issue random patterns (regenerated each cycle / variant switch).
    // - aValues[r * G + gK]: A's value at row r, K-column gK
    // - bValues[gK * G + c]: B's value at K-row gK, col c
    // - cPattern[r * G + c]: C accumulator — previous issue's final D
    // - cumD[gK][r * G + c]: D's state after grid-K-iters [0..gK]. Computed as
    //                        cumulative outer product of A[:,gK] and B[gK,:],
    //                        normalized so cumD[G-1].max ≈ 0.85. Cells receiving
    //                        big contributions THIS K-iter brighten visibly while
    //                        the active gridK band runs (gridFrac 0→1); cells with
    //                        small contributions stay near their previous value.
    //                        D and the K-scan finish in lockstep at phase=1.0.
    type IssueState = {
      aValues: number[]; bValues: number[];
      cPattern: number[]; cumD: number[][];
    };
    let issueState: IssueState | null = null;

    const generateIssue = (G: number) => {
      const N = G * G;
      const rand = () => 0.35 + Math.random() * 0.65;
      const newA = Array.from({ length: N }, rand);
      const newB = Array.from({ length: N }, rand);

      // Cumulative outer product: D_after_gK = sum_{j=0..gK} A[:,j] ⊗ B[j,:].
      const cumD: number[][] = [];
      const running = new Array(N).fill(0);
      for (let gK = 0; gK < G; gK++) {
        for (let r = 0; r < G; r++) {
          const a = newA[r * G + gK];
          for (let c = 0; c < G; c++) {
            const b = newB[gK * G + c];
            running[r * G + c] += a * b;
          }
        }
        cumD.push([...running]);
      }
      // Normalize so the final D peak ≈ 0.85 (room for shimmer overshoot)
      const finalMax = cumD[G - 1].reduce((m, v) => Math.max(m, v), 0);
      const scale = finalMax > 0 ? 0.85 / finalMax : 1;
      for (let gK = 0; gK < G; gK++) {
        for (let i = 0; i < N; i++) cumD[gK][i] *= scale;
      }

      // C carries over: previous issue's final D becomes this issue's accumulator.
      const newC = issueState && issueState.cumD.length
        ? [...issueState.cumD[issueState.cumD.length - 1]]
        : Array.from({ length: N }, rand);

      issueState = { aValues: newA, bValues: newB, cPattern: newC, cumD };
    };

    const counter   = document.getElementById("wmma-issue-counter");
    const issueLabel = document.getElementById("wmma-label");
    const kStrip    = document.getElementById("wmma-k-strip");
    const kCounter  = document.getElementById("wmma-k-counter");
    const laneStrip = document.getElementById("wmma-lane-strip");
    const infoTile  = document.getElementById("wmma-info-tile");
    const infoDtype = document.getElementById("wmma-info-dtype");
    const infoOps   = document.getElementById("wmma-info-ops");
    const infoPeak  = document.getElementById("wmma-info-peak");
    const infoNotes = document.getElementById("wmma-info-notes");

    // wave32 lane strip (32 cells, constant — wave32 is wave32 regardless of variant)
    if (laneStrip && !laneStrip.children.length) {
      for (let i = 0; i < 32; i++) {
        const lane = document.createElement("div");
        lane.className = "wmma-lane";
        lane.dataset.i = String(i);
        laneStrip.appendChild(lane);
      }
    }

    const buildTiles = () => {
      const v = variants[activeVariant];
      tileIds.forEach((id) => {
        const grid = document.getElementById(id);
        if (!grid) return;
        grid.innerHTML = "";
        grid.style.setProperty("--mfma-dim", String(v.gridDim));
        for (let r = 0; r < v.gridDim; r++) {
          for (let c = 0; c < v.gridDim; c++) {
            const cell = document.createElement("div");
            cell.className = "mfma-cell";
            cell.dataset.r = String(r);
            cell.dataset.c = String(c);
            grid.appendChild(cell);
          }
        }
      });

      // Build K-loop progress strip with one box per K iter
      if (kStrip) {
        kStrip.innerHTML = "";
        kStrip.style.setProperty("--k-iters", String(v.kIters));
        for (let i = 0; i < v.kIters; i++) {
          const seg = document.createElement("div");
          seg.className = "wmma-k-seg";
          seg.dataset.i = String(i);
          kStrip.appendChild(seg);
        }
      }

      // tile-label dtype text + dim labels
      widget.querySelectorAll<HTMLElement>(".mfma-tile").forEach((tile, idx) => {
        const dt = tile.querySelector(".mfma-dtype");
        if (!dt) return;
        if (idx === 0) dt.textContent = v.aType;
        else if (idx === 1) dt.textContent = v.bType;
        else dt.textContent = v.cType;
      });
      widget.querySelectorAll<HTMLElement>(".wmma-dim-label").forEach((el) => {
        el.innerHTML = v.dimLabel.replace("×", "&times;");
      });
      if (issueLabel) {
        issueLabel.textContent = v.info.ops + " · " + v.info.peak.split(" · ").pop()!;
      }

      // info panel
      if (infoTile)  infoTile.textContent  = v.info.tile;
      if (infoDtype) infoDtype.innerHTML   = v.info.dtype.replace("×", "&times;").replace("→", "&rarr;");
      if (infoOps)   infoOps.textContent   = v.info.ops;
      if (infoPeak)  infoPeak.textContent  = v.info.peak;
      if (infoNotes) infoNotes.textContent = v.info.notes;

      // CSS accent for variant color
      widget.setAttribute("data-active-variant", activeVariant);
      (widget as HTMLElement).style.setProperty("--wmma-accent", v.accent);
    };

    // Render at a given normalized phase [0, 1) within one issue cycle.
    // `wallT` is performance.now() in ms — used for breathing pulses that are
    // independent of the issue phase (so C breathes even at phase=0).
    const renderAt = (phase: number, wallT: number) => {
      const v = variants[activeVariant];
      const G = v.gridDim;
      const K = v.kIters;
      if (!issueState) generateIssue(G);
      const st = issueState!;

      // Actual K-iter counter (advances K times per issue, matches the K-strip)
      const k = Math.min(K - 1, Math.floor(phase * K));
      // Grid-level K-column index (advances G times per issue)
      const gridFine = phase * G;
      const gridK    = Math.min(G - 1, Math.floor(gridFine));
      const gridFrac = gridFine - gridK;

      // A: column = gridK lights up with PER-CELL values (so the column isn't uniform);
      //    cells outside that column are dim. Adds a small phase-modulated shimmer
      //    so the active column is visibly "live", not painted on.
      const aGrid = document.getElementById("wmma-A");
      if (aGrid) {
        const shimmer = 0.85 + 0.15 * Math.sin(wallT / 80);
        for (let i = 0; i < aGrid.children.length; i++) {
          const cell = aGrid.children[i] as HTMLElement;
          const r = parseInt(cell.dataset.r || "0", 10);
          const c = parseInt(cell.dataset.c || "0", 10);
          if (c === gridK) {
            const v = st.aValues[r * G + gridK] * shimmer;
            cell.style.setProperty("--heat", String(v));
          } else {
            cell.style.setProperty("--heat", "0.12");
          }
        }
      }
      // B: row = gridK with per-cell B values
      const bGrid = document.getElementById("wmma-B");
      if (bGrid) {
        const shimmer = 0.85 + 0.15 * Math.sin(wallT / 80 + 1.0);
        for (let i = 0; i < bGrid.children.length; i++) {
          const cell = bGrid.children[i] as HTMLElement;
          const r = parseInt(cell.dataset.r || "0", 10);
          const c = parseInt(cell.dataset.c || "0", 10);
          if (r === gridK) {
            const v = st.bValues[gridK * G + c] * shimmer;
            cell.style.setProperty("--heat", String(v));
          } else {
            cell.style.setProperty("--heat", "0.12");
          }
        }
      }
      // C: previous-issue's final D, held but visibly breathing. Higher-amplitude
      //    per-cell wobble (±20 %, faster) so the tile reads as "alive state".
      const cGrid = document.getElementById("wmma-C");
      if (cGrid) {
        for (let i = 0; i < cGrid.children.length; i++) {
          const cell = cGrid.children[i] as HTMLElement;
          const r = parseInt(cell.dataset.r || "0", 10);
          const c = parseInt(cell.dataset.c || "0", 10);
          const base = st.cPattern[r * G + c];
          const wob  = 0.78 + 0.22 * Math.sin(wallT / 320 + r * 0.5 + c * 0.7);
          cell.style.setProperty("--heat", String(base * wob));
        }
      }
      // D: physically-accurate cumulative outer-product accumulation.
      // Each K-iter adds rank-1 update A[:,gK] ⊗ B[gK,:]. We lerp between
      // cumD[gridK-1] and cumD[gridK] by gridFrac → cells receiving big
      // contributions this K-iter visibly brighten DURING the active iter,
      // cells with small contributions barely move. The "hot cells" shift
      // as gridK advances → motion that's tied to K-progress.
      const dGrid = document.getElementById("wmma-D");
      if (dGrid) {
        const dPrev = gridK > 0 ? st.cumD[gridK - 1] : null;
        const dCurr = st.cumD[gridK];
        for (let i = 0; i < dGrid.children.length; i++) {
          const cell = dGrid.children[i] as HTMLElement;
          const r = parseInt(cell.dataset.r || "0", 10);
          const c = parseInt(cell.dataset.c || "0", 10);
          const idx = r * G + c;
          const prev = dPrev ? dPrev[idx] : 0;
          const curr = dCurr[idx];
          const base = prev + (curr - prev) * gridFrac;       // smooth K-iter step
          const shimmer = 1 + 0.05 * Math.sin(wallT / 200 + r * 0.7 + c * 1.1);
          const heat = base * shimmer;
          cell.classList.toggle("filled", base > 0.02);
          cell.style.setProperty("--heat", String(heat));
        }
      }

      // K-loop progress strip
      if (kStrip) {
        for (let i = 0; i < kStrip.children.length; i++) {
          const seg = kStrip.children[i] as HTMLElement;
          seg.classList.toggle("active", i === k);
          seg.classList.toggle("past",   i < k);
        }
      }
      if (kCounter) kCounter.textContent = `${k + 1} / ${K}`;

      // wave32 lanes: subtle sweep so users see "the wave is working"
      if (laneStrip) {
        for (let i = 0; i < laneStrip.children.length; i++) {
          const lane = laneStrip.children[i] as HTMLElement;
          const offset = i / 32;
          const local = (phase + offset) % 1;
          const intensity = Math.sin(local * Math.PI);
          lane.style.setProperty("--lane-heat", String(intensity));
        }
      }
    };

    const loop = (t: number) => {
      const v = variants[activeVariant];
      const issueDuration = v.kIters * v.iterMs;
      if (!phaseStart) phaseStart = t;
      const elapsed = t - phaseStart;
      if (elapsed >= issueDuration) {
        // Issue boundary: regenerate per-cycle patterns so the next issue looks DIFFERENT,
        // and the just-completed D becomes the new C accumulator carry-in.
        phaseStart = t;
        issue += 1;
        if (counter) counter.textContent = String(issue);
        generateIssue(v.gridDim);
        renderAt(0, t);
      } else {
        renderAt(elapsed / issueDuration, t);
      }
      raf = requestAnimationFrame(loop);
    };

    buildTiles();
    generateIssue(variants[activeVariant].gridDim);
    renderAt(0, performance.now());
    raf = requestAnimationFrame(loop);

    widget.querySelectorAll<HTMLButtonElement>(".mfma-variant").forEach((btn) => {
      btn.addEventListener("click", () => {
        widget.querySelectorAll(".mfma-variant").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeVariant = btn.dataset.variant || "wmma_f16_16";
        phaseStart = 0;
        issue = 1;
        if (counter) counter.textContent = "1";
        issueState = null;  // force regeneration of patterns for the new variant
        buildTiles();
        generateIssue(variants[activeVariant].gridDim);
        renderAt(0, performance.now());
      });
    });

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting && raf) {
            cancelAnimationFrame(raf);
            raf = null;
            lastTime = 0;
          } else if (e.isIntersecting && !raf) {
            raf = requestAnimationFrame(loop);
          }
        });
      }, { threshold: 0.1 });
      io.observe(widget);
    }
  })();

  // ─────────── interactive roofline (batch-size slider → moving workload dot) ───────────
  (() => {
    const widget = document.querySelector('[data-widget="roofline"]');
    if (!widget) return;
    const input = widget.querySelector<HTMLInputElement>("#rl-input");
    const out = widget.querySelector<HTMLElement>("#rl-batch");
    const dot = widget.querySelector<SVGCircleElement>("#rl-dot");
    const leader = widget.querySelector<SVGLineElement>("#rl-leader");
    const dotLabel = widget.querySelector<SVGTextElement>("#rl-dot-label");
    const aiOut = widget.querySelector<HTMLElement>("#rl-ai");
    const boundOut = widget.querySelector<HTMLElement>("#rl-bound");
    const perfOut = widget.querySelector<HTMLElement>("#rl-perf");
    const shadeMem  = widget.querySelector<SVGRectElement>("#rl-shade-mem");
    const shadeDot2 = widget.querySelector<SVGRectElement>("#rl-shade-dot2");
    const shadeWmma = widget.querySelector<SVGRectElement>("#rl-shade-wmma");
    if (!input || !out || !dot || !leader || !dotLabel || !aiOut || !boundOut || !perfOut || !shadeMem || !shadeDot2 || !shadeWmma) return;

    // The SVG coords: x ∈ [60, 600] maps to log-ish AI 0.5 → 64.
    // Visual roof structure (the drawn lines, taken as ground truth):
    //   GDDR slope:  (60, 280) → (220, 80). Reaches the ridge at x=220 / AI≈2.
    //   dot2 roof:   y = 180 constant. Labeled "41 TF".
    //   WMMA roof:   y = 80  constant. Labeled "123 TF".
    //
    // We slide the dot along the AI axis as B grows, then snap it to whichever
    // roof binds: GDDR slope (memory-bound), dot2 ceiling (dot2 kernel,
    // compute-bound), or WMMA ceiling (WMMA kernel, compute-bound).

    const X_LEFT = 60;
    const X_RIGHT = 600;
    const Y_BOT = 280;
    const RIDGE_X = 220;     // intersection of GDDR slope and WMMA roof
    const WMMA_Y = 80;       // y of WMMA ceiling line
    const DOT2_Y = 180;      // y of dot2 ceiling line
    const WMMA_TF = 123;
    const DOT2_TF = 41;
    const AI_LO = 0.5, AI_HI = 64;

    const aiToX = (ai: number): number => {
      const t = Math.log(ai / AI_LO) / Math.log(AI_HI / AI_LO);
      return X_LEFT + Math.max(0, Math.min(1, t)) * (X_RIGHT - X_LEFT);
    };

    // AI grows roughly with B^0.85 (slower than linear — reflects real GEMM scaling).
    // Calibrated so:
    //   B=1  → AI≈0.8  (mem-bound, on GDDR slope, well below ridge)
    //   B=2  → AI≈1.0  (mem-bound, dot inches up)
    //   B=4  → AI≈1.4  (still mem-bound on GDDR slope but near dot2 crossover)
    //   B=8  → AI≈2.3  (just past ridge; kernel switches to WMMA path)
    //   B=16 → AI≈3.7  (well into WMMA roof region)
    //   B=64 → AI≈11   (far right, deep WMMA region)
    const aiForBatch = (B: number): number => 0.5 + 0.3 * Math.pow(B, 0.85);

    // Perf on the GDDR slope at a given x (TF, linear interp from 0 at x=60 to 123 at ridge).
    const gddrPerfAtX = (x: number): number =>
      Math.max(0, Math.min(WMMA_TF, WMMA_TF * (x - X_LEFT) / (RIDGE_X - X_LEFT)));

    // y coord on the GDDR slope at x.
    const gddrYAtX = (x: number): number => {
      const t = Math.max(0, Math.min(1, (x - X_LEFT) / (RIDGE_X - X_LEFT)));
      return Y_BOT + (WMMA_Y - Y_BOT) * t;
    };

    // Kernel path: small-batch GEMMs use dot2 (no matrix unit fed), B≥8 switches to WMMA.
    const kernelFor = (B: number): { ceil: number; y: number; path: "dot2" | "wmma" } => {
      if (B >= 8) return { ceil: WMMA_TF, y: WMMA_Y, path: "wmma" };
      return { ceil: DOT2_TF, y: DOT2_Y, path: "dot2" };
    };

    const attainedAt = (B: number): {
      x: number; y: number; perf: number; bound: "mem" | "dot2" | "wmma";
    } => {
      const ai = aiForBatch(B);
      const x = aiToX(ai);
      const memPerf = gddrPerfAtX(x);
      const k = kernelFor(B);
      // The dot lands on whichever roof gives lower perf:
      //   memPerf < k.ceil → memory-bound, dot on the GDDR slope
      //   memPerf ≥ k.ceil → compute-bound, dot pinned to the kernel's ceiling
      if (memPerf < k.ceil) {
        return { x, y: gddrYAtX(x), perf: memPerf, bound: "mem" };
      }
      return { x, y: k.y, perf: k.ceil, bound: k.path };
    };

    const boundCopy: Record<"mem" | "dot2" | "wmma", { label: string; color: string; }> = {
      mem:  { label: "GDDR bandwidth", color: "#e11d2a" },
      dot2: { label: "dot2 ceiling (41 TF)", color: "#fbbf24" },
      wmma: { label: "WMMA ceiling (123 TF)", color: "#4ade80" },
    };

    const regimeText = (B: number, bound: "mem" | "dot2" | "wmma"): string => {
      if (bound === "mem")  return B === 1 ? "decode GEMV"  : "small-batch prefill";
      if (bound === "dot2") return "dot2-bound prefill";
      return "wide prefill";
    };

    const update = (animated = true) => {
      const B = parseInt(input.value, 10);
      const ai = aiForBatch(B);
      const { x, y, perf, bound } = attainedAt(B);

      if (animated) {
        dot.style.transition = "cx 220ms cubic-bezier(.25,.8,.25,1), cy 220ms cubic-bezier(.25,.8,.25,1), fill 220ms ease";
        leader.style.transition = "x1 220ms, x2 220ms, y2 220ms";
        dotLabel.style.transition = "x 220ms, y 220ms";
      }
      dot.setAttribute("cx", String(x));
      dot.setAttribute("cy", String(y));
      dot.setAttribute("fill", boundCopy[bound].color);
      leader.setAttribute("x1", String(x));
      leader.setAttribute("x2", String(x));
      leader.setAttribute("y2", String(y));
      leader.setAttribute("stroke", boundCopy[bound].color);

      // Label sits to the LEFT of the dot when it's near the right edge to avoid overflow.
      const labelOnLeft = x > X_RIGHT - 130;
      const labelX = labelOnLeft ? x - 12 : x + 12;
      dotLabel.setAttribute("x", String(labelX));
      dotLabel.setAttribute("y", String(y + 3));
      dotLabel.setAttribute("text-anchor", labelOnLeft ? "end" : "start");
      dotLabel.textContent = `B=${B} · ${regimeText(B, bound)}`;

      shadeMem.setAttribute("opacity",  bound === "mem"  ? "0.20" : "0.04");
      shadeDot2.setAttribute("opacity", bound === "dot2" ? "0.20" : "0.04");
      shadeWmma.setAttribute("opacity", bound === "wmma" ? "0.22" : "0.04");

      out.textContent = `B=${B}`;
      aiOut.textContent = `~${ai.toFixed(1)} FLOPs/byte`;
      boundOut.textContent = boundCopy[bound].label;
      boundOut.style.color = boundCopy[bound].color;
      perfOut.textContent = `~${perf.toFixed(0)} TFLOPs/s`;
    };

    input.addEventListener("input", () => update(true));
    update(false);

    // gentle idle oscillation: slowly sweep the batch up/down when the page is open but user hasn't touched the slider
    let idleSweep = true;
    let idleStart = performance.now();
    input.addEventListener("input", () => { idleSweep = false; });
    const idleAnim = (t: number) => {
      if (idleSweep) {
        // 8 second cycle, batch sweeps 1 → 48 → 1
        const phase = ((t - idleStart) / 8000) % 1;
        const tri = phase < 0.5 ? phase * 2 : (1 - phase) * 2; // triangle wave [0..1..0]
        const B = Math.round(1 + tri * 47);
        if (parseInt(input.value, 10) !== B) {
          input.value = String(B);
          update(true);
        }
      }
      requestAnimationFrame(idleAnim);
    };
    requestAnimationFrame(idleAnim);
  })();

  // ─────────── bar chart: reveal on scroll + count up ───────────
  (() => {
    const reveal = (el: Element) => {
      el.querySelectorAll<HTMLElement>(".bar-fill[data-target]").forEach((bar) => {
        const pct = parseFloat(bar.dataset.target || "0");
        // small stagger
        requestAnimationFrame(() => { bar.style.width = `${pct}%`; });
      });
      el.querySelectorAll<HTMLElement>("[data-count-to]").forEach((n) => {
        const end = parseFloat(n.dataset.countTo || "0");
        const dur = 1200;
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          n.textContent = String(Math.round(end * eased));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };

    const charts = document.querySelectorAll('[data-widget="bar-chart-reveal"]');
    if (!charts.length) return;
    if (!("IntersectionObserver" in window)) {
      charts.forEach(reveal);
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          reveal(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    charts.forEach((c) => io.observe(c));
  })();
</script>
