            <tr>
              <th>arch</th>
              <th>LLVM target</th>
              <th class="num">wave</th>
              <th class="num">VGPRs / SIMD</th>
              <th class="num">waves / SIMD</th>
              <th class="num">LDS (max WG / WGP)</th>
              <th>matrix path</th>
            </tr>
          </thead>
          <tbody>
