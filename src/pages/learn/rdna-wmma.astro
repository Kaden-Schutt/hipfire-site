            <tr><td>Navi 31 (7900 XT/XTX)</td><td><code>gfx1100</code></td><td class="num">32</td><td class="num">1536</td><td class="num">16</td><td class="num">&le;64 KB WG &middot; 128 KB WGP</td><td class="accent"><strong>WMMA</strong> (16&times;16&times;16, half16)</td></tr>
