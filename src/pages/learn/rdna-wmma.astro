          </div>
          <div class="mfma-issue">
            <span class="mfma-issue-counter" id="wmma-issue-counter">1</span>
            issue &middot; <span class="mfma-issue-label" id="wmma-label">4096 FMA (8192 FLOPs) per issue &mdash; ~123 TFLOPs theoretical peak, 7900 XTX (model)</span>
          </div>
          <div class="mfma-variants">
            <button class="mfma-variant active" data-variant="wmma_f16_16">RDNA3 &middot; 16&times;16&times;16 fp16</button>
            <button class="mfma-variant" data-variant="wmma_bf16_16">RDNA3 &middot; bf16</button>
            <button class="mfma-variant" data-variant="wmma_i8_16">RDNA3 &middot; i8 WMMA</button>
            <button class="mfma-variant" data-variant="wmma32">RDNA4 &middot; gfx12 WMMA (half8)</button>
          </div>

          <dl class="wmma-info" id="wmma-info">
            <div class="wmma-info-row">
              <dt>tile shape</dt>
              <dd id="wmma-info-tile">M=16, N=16, K=16</dd>
            </div>
            <div class="wmma-info-row">
              <dt>inputs &middot; output</dt>
              <dd id="wmma-info-dtype">fp16 &times; fp16 &rarr; fp32 accumulator</dd>
            </div>
            <div class="wmma-info-row">
              <dt>per issue</dt>
              <dd id="wmma-info-ops">4096 FMA (8192 FLOPs) &middot; 16-element dot product per output cell</dd>
            </div>
            <div class="wmma-info-row">
              <dt>theoretical peak</dt>
              <dd id="wmma-info-peak">~123 TFLOPs &middot; 7900 XTX (gfx1100) theoretical model, not measured</dd>
            </div>
            <div class="wmma-info-row">
