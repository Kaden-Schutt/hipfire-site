      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>example card</th>
              <th>LLVM target</th>
              <th class="num">VGPRs / SIMD</th>
              <th class="num">Infinity Cache</th>
              <th>matrix path</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>RX 5700 XT (RDNA1)</td><td><code>gfx1010</code></td><td class="num">1024*</td><td class="num">&mdash;</td><td><strong>packed fp16</strong> (no packed DOT, no WMMA)</td></tr>
            <tr><td>RX 6900 XT (RDNA2)</td><td><code>gfx1030</code></td><td class="num">1024</td><td class="num">128 MiB</td><td><strong>v_dot4 / v_dot2</strong> (packed DOT, no WMMA)</td></tr>
            <tr><td>RX 7900 XTX (RDNA3)</td><td><code>gfx1100</code></td><td class="num">1536</td><td class="num">96 MiB</td><td class="accent"><strong>WMMA</strong> (16&times;16&times;16, half16)</td></tr>
            <tr><td>RX 7800 XT / RX 7600</td><td><code>gfx1101</code> / <code>gfx1102</code></td><td class="num">1536 / 1024</td><td class="num">64 / 32 MiB</td><td class="accent"><strong>WMMA</strong> (16&times;16&times;16, half16)</td></tr>
            <tr><td>Radeon 8060S, Strix Halo (RDNA3.5)</td><td><code>gfx1151</code></td><td class="num">1536</td><td class="num">32 MiB</td><td class="accent"><strong>WMMA</strong> (16&times;16&times;16, half16)</td></tr>
