            <!-- comet trail: drawn first (behind glow + dot). JS sets x1 = x ± 130 depending on direction. -->
            <line id="gen-trail" x1="100" y1="320" x2="100" y2="320" stroke="url(#gen-trail-grad)" stroke-width="9" stroke-linecap="round" opacity="0"/>

            <!-- glow halo behind the dot -->
