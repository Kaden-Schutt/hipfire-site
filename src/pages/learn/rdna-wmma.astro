import { tagBlob, RELEASE_URL, RELEASE_CHANGELOG } from "../../data/learn";

const description =
  "RDNA silicon for LLM inference: wave32, the WMMA matrix unit on gfx11 and gfx12, occupancy, the memory ladder, dispatch from gfx1010 to gfx1201, and which WMMA instructions hipfire 0.4.1 issues on Strix Halo and the R9700.";
---

<LearnLayout title="RDNA & WMMA" description={description}>
  <article class="distil">
    <div class="distil-meta">
      <a href="/learn">/learn</a> &middot; silicon &middot; RDNA / WMMA
    </div>
    <h1 class="distil-title">RDNA &amp; WMMA</h1>
    <p class="distil-lede">
      Companion to <a href="/learn/cdna-mfma">CDNA &amp; MFMA</a>. This page
      covers the other AMD compute family: RDNA (consumer, pro and APU), the
      <strong>WMMA</strong> matrix path that arrived with RDNA3, and how hipfire
      0.4.1 uses it on the two release cards, Strix Halo (<code>gfx1151</code>)
      and the Radeon AI PRO R9700 (<code>gfx1201</code>).
    </p>
    <p class="distil-lede">
      The consumer-silicon realities: <strong>wave32, GDDR6 or shared system
      RAM, 16&times;16&times;16 matrix tiles via WMMA, and a dispatch story that
      spans RDNA1 (no matrix unit at all) to RDNA4 (a new gfx12 WMMA layout on
      the same 16&times;16&times;16 tile)</strong>.
    </p>

    <hr class="distil-rule" />

    <!-- ============================================================ 1 -->
