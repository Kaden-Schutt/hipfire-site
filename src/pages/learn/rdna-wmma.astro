                <text x="740" y="257" class="gen-feat-txt">dp4a</text>
                <rect x="700" y="214" width="80" height="22" class="gen-feat" data-tier="dot2"/>
                <text x="740" y="229" class="gen-feat-txt">dot2 fp16</text>
                <rect x="700" y="148" width="80" height="56" class="gen-feat gen-feat-flag" data-tier="wmma32"/>
