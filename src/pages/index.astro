---
import Base from "../layouts/Base.astro";
import {
  ENGINE_REPO_TREE,
  ENGINE_INSTALL_SCRIPT,
  FRESHNESS_NOTE,
  HETEROGENEOUS_NOTE,
  heroStats,
  qwen36Mq4r,
  qwen38Mq4v2,
  deepseekV4FlashMq2r,
} from "../data/performance";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "hipfire",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux",
  "description":
    "Rust-native LLM inference engine for AMD RDNA GPUs. A Rust engine over hand-written HIP kernels. No PyTorch. No Python in the hot path.",
  "url": "https://hipfire.dev",
  "license": [
    "https://www.apache.org/licenses/LICENSE-2.0",
    "https://opensource.org/licenses/MIT",
  ],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "softwareRequirements": "Linux with ROCm 6+ and an AMD RDNA GPU",
  "codeRepository": ENGINE_REPO_TREE,
  "programmingLanguage": ["Rust", "HIP C++"],
};

---

<Base title="hipfire">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <main>
    <section class="hero">
      <img class="hero-wordmark" src="/assets/hipfire-wordmark.svg" alt="hipfire" />
      <h1 class="hero-tagline">LLM inference for AMD RDNA GPUs.</h1>

      <div class="hero-stats">
        {heroStats.map((s) => (
          <div class="hero-stat">
            <div class="hero-stat-val">{s.value}</div>
            <div class="hero-stat-label">
              {s.unitLabel}
              <span class="hero-stat-sub">{s.sub}</span>
            </div>
          </div>
        ))}
      </div>

      <p class="hero-sub">
        A Rust engine over hand-written HIP kernels &mdash; two
        <code>dlopen</code> calls into ROCm at runtime, nothing else.
        No PyTorch. No Python in the hot path. Single binary.
      </p>

      <div class="hero-bullets">
        <span>no PyTorch</span>
        <span>no Python in the hot path</span>
        <span>single binary</span>
        <span>Ollama-style UX</span>
      </div>

      <div class="hero-cta">
        <a class="btn btn-primary" href="#perf">see the numbers <span class="chev">&gt;&gt;&gt;</span></a>
        <a class="btn btn-ghost" href="#quickstart">get started</a>
        <a class="btn btn-ghost" href={ENGINE_REPO_TREE}>github</a>
        <a class="btn btn-ghost" href="https://discord.gg/F3BaywB8Rs">discord</a>
      </div>
    </section>

    <section id="perf" class="section">
      <h2>performance snapshots</h2>

      <div class="card" style="margin-bottom: 28px; border-left: 3px solid var(--accent);">
        <p style="margin: 0; color: var(--fg); font-size: 14px; line-height: 1.55; max-width: none;">
          <strong class="accent">Beta moves fast.</strong>
          {FRESHNESS_NOTE}
        </p>
      </div>

      <p class="lede">
        Three independent fixtures — different models, quants, and hardware
        setups. {HETEROGENEOUS_NOTE}
      </p>

      <h3>Qwen3.6 35B-A3B MQ4R · single-GPU AR</h3>
      <p>
        {qwen36Mq4r.method}
      </p>
      <div class="table-wrap">
        <table class="perf">
          <thead>
            <tr>
              <th>GPU</th>
              <th>arch</th>
              <th class="num">TG128 AR</th>
              <th class="num">8-turn avg</th>
              <th class="num">final turn</th>
            </tr>
          </thead>
          <tbody>
            {qwen36Mq4r.rows.map((r) => (
              <tr>
                <td>{r.gpu}</td>
                <td>{r.arch}</td>
                <td class="num"><strong>{r.tg128Ar.toFixed(1)}</strong> tok/s</td>
                <td class="num">{r.eightTurnAvg.toFixed(1)} tok/s</td>
                <td class="num">{r.finalTurn}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Source:
        <a href={qwen36Mq4r.sourceUrl}>{qwen36Mq4r.sourceLabel}</a>
        &middot; live ledger: <a href="/docs/benchmarks">/docs/benchmarks</a>
      </p>

      <h3 style="margin-top: 32px;">
        Qwen3.8-27B MQ4V2 · {qwen38Mq4v2.date} · {qwen38Mq4v2.fixture}
      </h3>
      <p>
        {qwen38Mq4v2.method}
      </p>
      <div class="table-wrap">
        <table class="perf">
          <thead>
            <tr>
              <th>tier</th>
              <th class="num">AR decode</th>
              <th class="num">prefill</th>
              <th class="num">DFlash</th>
              <th class="num">τ</th>
              <th class="num">bpw</th>
            </tr>
          </thead>
          <tbody>
            {qwen38Mq4v2.rows.map((r) => (
              <tr>
                <td><strong>{r.tier}</strong></td>
                <td class="num">{r.ar.toFixed(1)} tok/s</td>
                <td class="num">{r.prefill.toFixed(1)}</td>
                <td class="num"><strong>{r.dflash.toFixed(1)}</strong> tok/s</td>
                <td class="num">{r.tau.toFixed(2)}</td>
                <td class="num">{r.bpw.toFixed(3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Dated {qwen38Mq4v2.date}. Source:
        <a href={qwen38Mq4v2.sourceUrl}>{qwen38Mq4v2.sourceLabel}</a>
        (<code>{qwen38Mq4v2.sourcePath}</code>)
      </p>

      <h3 style="margin-top: 32px;">
        DeepSeek V4 Flash MQ2R · {deepseekV4FlashMq2r.fixture}
      </h3>
      <p>
        {deepseekV4FlashMq2r.method}
      </p>
      <div class="table-wrap">
        <table class="perf">
          <thead>
            <tr>
              <th>topology</th>
              <th class="num">decode</th>
              <th class="num">prefill</th>
            </tr>
          </thead>
          <tbody>
            {deepseekV4FlashMq2r.rows.map((r) => (
              <tr>
                <td><strong>{r.topology}</strong></td>
                <td class="num"><strong>{r.decode.toFixed(1)}</strong> tok/s</td>
                <td class="num">{r.prefill} tok/s</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Source:
        <a href={deepseekV4FlashMq2r.sourceUrl}>{deepseekV4FlashMq2r.sourceLabel}</a>
        &middot; live ledger: <a href="/docs/benchmarks">/docs/benchmarks</a>
      </p>
    </section>

    <section id="quickstart" class="section">
      <h2>quickstart</h2>
      <p class="lede">Linux with ROCm 6+ and an RDNA GPU.</p>
      <pre class="code"><span class="prompt">$</span> curl -L {ENGINE_INSTALL_SCRIPT} | bash

<span class="prompt">$</span> hipfire pull qwen3.5:9b
<span class="prompt">$</span> hipfire run  qwen3.5:9b <span class="str">"What is the capital of France?"</span>
<span class="prompt">$</span> hipfire serve -d   <span class="cmt"># background daemon, OpenAI-compatible API on :11435</span>

<span class="prompt">$</span> hipfire pull flux.schnell:1
<span class="prompt">$</span> hipfire img  flux.schnell:1 <span class="str">"a tiny lighthouse on a rock at sunset"</span> --out lighthouse.png</pre>
      <p class="footnote">
        Windows, source builds, and NixOS: see
        <a href="/docs/getting_started">Getting started</a> and
        <a href="/docs/nixos">NixOS</a>.
      </p>
    </section>

    <section id="hardware" class="section">
      <h2>hardware support</h2>
      <div class="table-wrap">
        <table class="hw">
          <thead><tr><th>arch</th><th>example</th><th>status</th></tr></thead>
          <tbody>
            <tr><td>gfx1100 (RDNA 3)</td><td>Radeon 7900 XTX / XT</td><td class="ok">primary target &mdash; tuned</td></tr>
            <tr><td>gfx1201 (RDNA 4)</td><td>Radeon 9070 XT, R9700</td><td class="ok">supported</td></tr>
            <tr><td>gfx1151 (RDNA 3.5)</td><td>Strix Halo APU</td><td class="ok">supported</td></tr>
            <tr><td>gfx1030 (RDNA 2)</td><td>Radeon 6950 XT</td><td class="ok">supported</td></tr>
            <tr><td>gfx1010 (RDNA 1)</td><td>Radeon 5700 XT</td><td class="warn">experimental</td></tr>
            <tr><td>gfx906 (Vega 20)</td><td>MI50 / MI60</td><td class="warn">community-driven</td></tr>
            <tr><td>gfx942 (CDNA 3)</td><td>MI300X</td><td class="warn">rocBLAS path, partial</td></tr>
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Per-arch kernel variants live in <code>kernels/src/*.gfxNNNN.hip</code>; dispatch is
        feature-gated (<code>has_wmma_f16</code>, <code>has_dot2_f32_f16</code>),
        not chip-string matching.
      </p>
    </section>

    <section id="pitch" class="section section-narrow">
      <h2>HIP, not ROCm-the-stack</h2>
      <p>
        <code>llama.cpp + ROCm</code> works on RDNA, but it leans on a userspace
        stack &mdash; rocBLAS, MIOpen, hipBLASLt, Tensile &mdash; that AMD
        officially supports on a handful of datacenter cards. Consumer RDNA is
        a second-class citizen there.
      </p>
      <p>
        hipfire takes a different path: a Rust orchestrator that <code>dlopen</code>s
        <code>libamdhip64.so</code> directly, plus an in-tree set of HIP C++
        kernels that we tune per chip. <code>librocblas.so</code> is loaded
        lazily and only used on MI300X-class hardware; absence is recoverable.
        We don't call MIOpen, RCCL, hipBLASLt, or Composable Kernel.
      </p>
      <p>
        The pattern is borrowed from
        <a href="https://github.com/ncdrone/rustane">ncdrone/rustane</a>'s
        approach to Apple's Neural Engine: safe Rust over a thin FFI to
        whatever the driver runtime actually exposes.
      </p>
    </section>

    <section id="features" class="section">
      <h2>what's in the box</h2>
      <div class="grid">
        <div class="card">
          <h3>Hand-written HIP kernels</h3>
          <p>Architecture-gated paths from RDNA 1 through RDNA 4, plus gfx906 and CDNA support, with ordinary HIP fallback when a validated retained route cannot run.</p>
        </div>
        <div class="card">
          <h3>Magnum V2 quantization</h3>
          <p>MQ3&ndash;MQ6 V2 for dense Qwen 3.8, plus quality and speed tiers for MoE models.</p>
        </div>
        <div class="card">
          <h3>DFlash speculative decode</h3>
          <p>Registry-paired draft sidecars, explicit opt-in controls, and prompt-cache-safe multi-turn serving. Gains remain prompt- and genre-dependent.</p>
        </div>
        <div class="card">
          <h3>FlashAttention &amp; asym KV</h3>
          <p>Asym2 / Asym3 / Asym4 KV-cache compression keeps long contexts cheap on consumer VRAM budgets.</p>
        </div>
        <div class="card">
          <h3>Multi-GPU pipeline parallel</h3>
          <p>Including mixed-arch &mdash; e.g. gfx1010 + gfx1030 + gfx1151 + gfx1201 in one rig.</p>
        </div>
        <div class="card">
          <h3>OpenAI-compatible API</h3>
          <p><code>hipfire serve -d</code> exposes <code>/v1/chat/completions</code> on <code>:11435</code>.</p>
        </div>
        <div class="card">
          <h3>MoE &amp; hybrid models</h3>
          <p>Qwen 3.6 35B-A3B and Ornith 1.5, with DeltaNet recurrent-state caching across turns.</p>
        </div>
        <div class="card">
          <h3>Image generation</h3>
          <p>FLUX.1 schnell + FLUX.2 Klein on RDNA3/3.5 &mdash; <code>hipfire img</code> and OpenAI-compatible <code>/v1/images/generations</code> + <code>/edits</code>.</p>
        </div>
        <div class="card">
          <h3>Vision sidecars</h3>
          <p>Qwen 3.8 27B vision is an opt-in shared sidecar, so text-only serving pays no vision-tower VRAM cost.</p>
        </div>
        <div class="card">
          <h3>BYO models</h3>
          <p>Quantize from HuggingFace safetensors or llama.cpp GGUF via <code>hipfire quantize</code> &mdash; CPU-side, no GPU required.</p>
        </div>
        <div class="card">
          <h3>NixOS first-class</h3>
          <p>Flake, dev shell, and a <code>services.hipfire</code> NixOS module.</p>
        </div>
      </div>
    </section>

    <section id="learn" class="section section-narrow">
      <h2>learn</h2>
      <p class="lede">
        Short, dense decks on the silicon underneath. The HIP/ROCm side of the
        conversation that <code>brrr</code>-style CUDA explainers don't cover.
      </p>
      <div class="distil-deck-list">
        <a class="distil-card" href="/learn/rdna-wmma">
          <div class="distil-card-tag">deck 01 &middot; consumer / pro / APU</div>
          <h3 class="distil-card-title">RDNA &amp; WMMA</h3>
          <p class="distil-card-sub">
            wave32, GDDR / system-RAM, 16&times;16 matrix tiles via WMMA, with
            empirical hipfire numbers across gfx1010 &rarr; gfx1201.
          </p>
          <div class="distil-card-meta">
            <span class="accent">historical: 2.94&times; prefill snapshot</span>
          </div>
        </a>
        <a class="distil-card" href="/learn/cdna-mfma">
          <div class="distil-card-tag">deck 02 &middot; data center</div>
          <h3 class="distil-card-title">CDNA &amp; MFMA</h3>
          <p class="distil-card-sub">
            The Instinct lineage. wave64, HBM3, <code>v_mfma_*</code> tiles,
            and the rocprofv3 counters that diagnose where cycles go.
          </p>
          <div class="distil-card-meta">
            <span class="accent">MI300X: 304 CUs &middot; 192 GB HBM3</span>
          </div>
        </a>
      </div>
      <p class="footnote">
        See the full index at <a href="/learn">/learn</a>.
      </p>
    </section>

    <section id="docs" class="section section-narrow">
      <h2>documentation</h2>
      <ul class="doclinks">
        <li><a href="/docs/getting_started">Getting started</a> &mdash; install, first run</li>
        <li><a href="/docs/cli">CLI reference</a> &mdash; every subcommand</li>
        <li><a href="/docs/models">Models</a> &mdash; curated tags &amp; BYO</li>
        <li><a href="/docs/quantize">Quantize</a> &mdash; HF / safetensors / GGUF &rarr; hipfire formats</li>
        <li><a href="/docs/serve">Serve</a> &mdash; OpenAI-compatible HTTP API</li>
        <li><a href="/docs/architecture">Architecture</a> &mdash; load sources, carriers, graph, and dispatch</li>
        <li><a href="/docs/quantization">Quantization design</a> &mdash; MQ4 / HFQ4 / asym KV / FWHT math</li>
        <li><a href="/docs/multi-gpu">Multi-GPU</a> &mdash; pipeline-parallel, memory budget</li>
        <li><a href="/docs/benchmarks">Benchmarks</a> &mdash; live rows and fixture-scoped snapshots</li>
      </ul>
      <p class="footnote">
        Looking for the &ldquo;how GPUs actually work&rdquo; pictures?
        See <a href="/learn">/learn</a> &mdash; RDNA / WMMA and CDNA / MFMA decks.
      </p>
    </section>
  </main>
</Base>
