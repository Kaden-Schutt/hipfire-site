---
import Base from "../layouts/Base.astro";
import StatTiles from "../components/StatTiles.astro";
import CopyButton from "../components/CopyButton.astro";
import TerminalReplay from "../components/TerminalReplay.astro";
import { ENGINE_REPO_TREE } from "../data/performance";
import { r9700Fn, qwen27b } from "../data/release041";
import { RELEASE_URL, RELEASE_INSTALL_SCRIPT, npuHeadline } from "../data/release042";

const BENCH = "/benchmarks/0.4.2";
const DISCORD = "https://discord.gg/F3BaywB8Rs";

const fmt = (n: number, digits = 0) =>
  n.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });

const installCmd = `curl -L ${RELEASE_INSTALL_SCRIPT} | bash`;
const quickstart = [installCmd, "hipfire pull qwen3.5:9b", "hipfire serve -d"];

const xtx_27b = qwen27b.gpus.find((g) => g.arch === "gfx1100")!;

const whatsNew: { title: string; body: string; credit?: boolean }[] = [
  {
    title: "The NPU joins prefill",
    body: "On Strix Halo, Qwen3.8-Flash runs its trunk input projections on the XDNA2 NPU by default: 16K prefill at 2,386 tok/s, greedy output byte-identical to the gate build. It needs a bounded memlock limit.",
  },
  {
    title: "Faster 27B DFlash",
    body: "Qwen3.8 27B uses its paired DFlash draft by default, and exact 16-row verify kernels make it about 38 % faster on Strix Halo.",
  },
  {
    title: "More throughput under load",
    body: "Batching serves pick DFlash width 8 and IU4 verify automatically, for higher C8 throughput on the R9700 at a small lone-request cost.",
  },
  {
    title: "Exact fusions on the NPU route",
    body: "The fused HC kernels now also run under the NPU pair route, and bank B's PLE rows are fetched ahead, with greedy bytes unchanged.",
  },
];

const models = [
  { name: "Qwen3.8-Flash", fig: `${fmt(npuHeadline.tps)} tok/s`, meta: "16K prefill on Strix Halo with the NPU" },
  { name: "Qwen3.8 27B", fig: `${fmt(xtx_27b.decMtp, 1)} tok/s`, meta: "output on a 7900 XTX with native MTP (0.4.1)" },
  { name: "Qwen3.6 35B-A3B", meta: "MoE, recurrent state cached across turns" },
  { name: "Qwen 3.5", meta: "qwen3.5:9b is the quickstart model" },
  { name: "DeepSeek V4 Flash", meta: "multi-GPU, tensor + expert parallel" },
  { name: "Ornith 1.5", meta: "MoE / hybrid" },
  { name: "FLUX.1 schnell · FLUX.2 Klein", meta: "image generation on RDNA 3 / 3.5" },
  { name: "Bring your own", meta: "quantize Hugging Face safetensors" },
];

const gpus = [
  { name: "Radeon RX 7900 XTX / XT", arch: "gfx1100 · RDNA 3", status: "Primary target", tone: "top" },
  {
    name: "Radeon AI PRO R9700 · RX 9070 XT",
    arch: "gfx1201 · RDNA 4",
    status: "Supported",
    tone: "ok",
    fig: `${fmt(r9700Fn.pp8192.median)} tok/s`,
    figLabel: "Qwen3.8-Flash prompt processing (0.4.1)",
  },
  {
    name: "Strix Halo APU",
    arch: "gfx1151 · RDNA 3.5",
    status: "Supported",
    tone: "ok",
    fig: `${fmt(npuHeadline.tps)} tok/s`,
    figLabel: "Qwen3.8-Flash 16K prefill with the NPU",
  },
  { name: "Radeon RX 6950 XT", arch: "gfx1030 · RDNA 2", status: "Supported", tone: "ok" },
  { name: "Radeon RX 5700 XT", arch: "gfx1010 · RDNA 1", status: "Experimental", tone: "warn" },
  { name: "Instinct MI50 / MI60", arch: "gfx906 · Vega 20", status: "Community", tone: "warn" },
  { name: "Instinct MI300X", arch: "gfx942 · CDNA 3", status: "Partial", tone: "warn" },
];

const props = [
  {
    title: "No PyTorch. No Python.",
    body: "A Rust engine that calls the HIP runtime directly and runs kernels written and tuned per chip. Nothing to pip install.",
  },
  {
    title: "One binary",
    body: "On Radeon cards hipfire needs the HIP runtime and nothing else from ROCm: no rocBLAS, MIOpen or hipBLASLt to version-match.",
  },
  {
    title: "OpenAI-compatible API",
    body: "hipfire serve exposes /v1/chat/completions on :11435, with tools and stop sequences, so existing clients and agent harnesses connect unchanged.",
  },
  {
    title: "Ollama-style UX",
    body: "pull, run and serve with curated model tags, or quantize your own from Hugging Face safetensors.",
  },
];

const extras = [
  "DFlash speculative decoding",
  "Magnum V2 quantization",
  "compressed KV cache",
  "multi-GPU, mixed architectures",
  "image generation",
  "vision sidecars",
  "NixOS module",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "hipfire",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux",
  "description":
    "Rust-native LLM inference engine for AMD RDNA GPUs. A Rust engine over hand-written HIP kernels. No PyTorch. No Python in the hot path.",
  "url": "https://hipfire.dev",
  "license": [
    "https://www.apache.org/licenses/LICENSE-2.0",
    "https://opensource.org/licenses/MIT",
  ],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "softwareRequirements": "Linux with ROCm 6+ and an AMD RDNA GPU",
  "codeRepository": ENGINE_REPO_TREE,
  "programmingLanguage": ["Rust", "HIP C++"],
};
---

<Base title="hipfire">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <main class="mkt">
    <section class="mkt-hero">
      <div class="mkt-wrap">
        <a class="mkt-pill" href={BENCH}>
          <span class="mkt-pill-tag">New in 0.4.2</span>
          <span>The Strix Halo NPU now helps Qwen3.8-Flash prefill</span>
          <span class="mkt-pill-arrow" aria-hidden="true">→</span>
        </a>

        <div class="mkt-hero-grid">
        <div class="mkt-hero-copy">
        <h1 class="mkt-h1">Fast local LLMs on the <span class="accent">AMD GPU</span> you already own.</h1>

        <p class="mkt-lede">
          hipfire is a Rust inference engine with hand-written HIP kernels for Radeon GPUs and Strix Halo.
          One binary. No Python, no PyTorch.
        </p>

        <div class="mkt-install">
          <code class="mkt-install-cmd"><span class="prompt" aria-hidden="true">$</span>{installCmd}</code>
          <CopyButton text={installCmd} label="Copy install command" />
        </div>
        <p class="mkt-install-note">
          Linux with ROCm 6+ ·
          <a href="/docs/getting_started">Windows, NixOS and source builds</a>
        </p>

        <div class="mkt-cta">
          <a class="btn btn-ghost" href={BENCH}>See the benchmarks</a>
          <a class="btn btn-ghost" href={ENGINE_REPO_TREE}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            GitHub
          </a>
        </div>
        </div>
        <TerminalReplay />
        </div>
      </div>
    </section>

    <section class="mkt-statband" aria-label="hipfire 0.4.2 headline numbers">
      <div class="mkt-wrap">
        <StatTiles release="0.4.2" />
        <p class="mkt-stat-foot">
          hipfire 0.4.2, release defaults. Qwen3.8-Flash (<code>qwen3.8:flash-next</code>) is the
          <code>qwen3.8-flash-next.mq4-xts</code> artifact (formerly <code>qwen3.8-flash-next-gptq3.mq4</code>, same
          bytes). Methods, fixtures and sources on the <a href={BENCH}>0.4.2 benchmarks page</a>.
        </p>
      </div>
    </section>

    <section id="whats-new" class="mkt-section">
      <div class="mkt-wrap">
        <p class="mkt-eyebrow">What's new in 0.4.2</p>
        <h2 class="mkt-h2">The NPU joins prefill, and 27B DFlash speeds up.</h2>
        <div class="mkt-grid-4">
          {whatsNew.map((c, i) => (
            <div class="mkt-card">
              <div class="mkt-card-num">0{i + 1}</div>
              <h3>{c.title}</h3>
              <p>
                {c.body}
                {c.credit && (
                  <> Built on <a href="https://github.com/fivetide">@fivetide</a>'s session-cache work.</>
                )}
              </p>
            </div>
          ))}
        </div>
        <div class="mkt-links">
          <a class="mkt-more" href={BENCH}>All 0.4.2 numbers</a>
          <a class="mkt-more" href={RELEASE_URL}>Release notes</a>
        </div>
      </div>
    </section>

    <section id="hardware" class="mkt-section">
      <div class="mkt-wrap">
        <p class="mkt-eyebrow">Models and hardware</p>
        <h2 class="mkt-h2">From one Strix Halo APU to a multi-GPU rig.</h2>
        <div class="mkt-split">
          <div>
            <h3 class="mkt-subhead">Models</h3>
            <ul class="mkt-models">
              {models.map((m) => (
                <li class="mkt-model">
                  <div class="mkt-model-name">{m.name}</div>
                  <div class="mkt-model-meta">
                    {m.fig && <span class="mkt-fig">{m.fig}</span>} {m.meta}
                  </div>
                </li>
              ))}
            </ul>
            <a class="mkt-more mkt-more-sm" href="/docs/models">Model tags and BYO</a>
          </div>
          <div>
            <h3 class="mkt-subhead">GPUs</h3>
            <ul class="mkt-gpus">
              {gpus.map((g) => (
                <li class="mkt-gpu">
                  <div>
                    <div class="mkt-gpu-name">{g.name}</div>
                    <div class="mkt-gpu-arch">{g.arch}</div>
                    {g.fig && (
                      <div class="mkt-gpu-fig"><span class="mkt-fig">{g.fig}</span> {g.figLabel}</div>
                    )}
                  </div>
                  <span class={`mkt-badge ${g.tone}`}>{g.status}</span>
                </li>
              ))}
            </ul>
            <a class="mkt-more mkt-more-sm" href="/docs/multi-gpu">Multi-GPU, including mixed architectures</a>
          </div>
        </div>
      </div>
    </section>

    <section id="why" class="mkt-section">
      <div class="mkt-wrap">
        <p class="mkt-eyebrow">Why hipfire</p>
        <h2 class="mkt-h2">Written for RDNA, not ported to it.</h2>
        <div class="mkt-props">
          {props.map((p) => (
            <div class="mkt-prop">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
        <div class="mkt-chips">
          <span class="mkt-chips-label">Also in the box:</span>
          {extras.map((e) => <span class="mkt-chip">{e}</span>)}
        </div>
        <a class="mkt-more mkt-more-sm" href="/learn/why-hipfire">The RDNA-native thesis</a>
      </div>
    </section>

    <section id="quickstart" class="mkt-section">
      <div class="mkt-wrap mkt-qs">
        <div>
          <p class="mkt-eyebrow">Quickstart</p>
          <h2 class="mkt-h2">Running in three commands.</h2>
          <p class="mkt-intro">
            Install, pull a model, and serve an OpenAI-compatible API on <code>:11435</code>.
          </p>
          <ul class="mkt-doclinks">
            <li><a class="mkt-more" href="/docs/getting_started">Getting started</a></li>
            <li><a class="mkt-more" href="/docs/cli">CLI reference</a></li>
            <li><a class="mkt-more" href="/docs/serve">Serve API</a></li>
            <li><a class="mkt-more" href={DISCORD}>Join the Discord</a></li>
          </ul>
        </div>
        <div class="mkt-term">
          <div class="mkt-term-bar">
            <span class="mkt-term-dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <CopyButton text={quickstart.join("\n")} label="Copy quickstart commands" variant="ghost" />
          </div>
          <pre><span class="prompt">$</span>{quickstart[0]}
<span class="prompt">$</span>{quickstart[1]}
<span class="prompt">$</span>{quickstart[2]}   <span class="cmt"># OpenAI-compatible API on :11435</span></pre>
        </div>
      </div>
    </section>
  </main>
</Base>
