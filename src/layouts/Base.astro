---
import "../styles/global.css";
import ogCards from "../data/og-cards.json";

interface Props {
  title: string;
  description?: string;
  /** Social card: a /public path or absolute URL. Defaults to the site card. */
  ogImage?: string;
  /** Alt text for ogImage; generated cards carry their own. */
  ogImageAlt?: string;
  noindex?: boolean;
}

const DEFAULT_OG_IMAGE = "/og/default.png";

const {
  title,
  description = "LLM inference for AMD RDNA GPUs. A Rust engine over hand-written HIP kernels. No PyTorch. No Python in the hot path.",
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  noindex = false,
} = Astro.props;

// Generated cards (scripts/render-og.mjs) are listed in og-cards.json. A /og/ path with no
// rendered card, such as a post published since the last render, uses the site card.
const cards: Record<string, { alt: string }> = ogCards.cards;
const ogPath = ogImage.startsWith("/og/") && !(ogImage in cards) ? DEFAULT_OG_IMAGE : ogImage;
const card = cards[ogPath];

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbs = new URL(ogPath, Astro.site).toString();
const fullTitle = title === "hipfire" ? "hipfire — LLM inference for AMD RDNA GPUs" : `${title} — hipfire`;
const ogAlt = ogImageAlt ?? card?.alt ?? fullTitle;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/assets/hipfire-mark.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    {card && <meta property="og:image:type" content="image/png" />}
    {card && <meta property="og:image:width" content={String(ogCards.width)} />}
    {card && <meta property="og:image:height" content={String(ogCards.height)} />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hipfire" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="alternate" type="application/rss+xml" title="hipfire blog" href="/blog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" />

    <slot name="head" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="hipfire home">
        <img class="brand-mark" src="/assets/hipfire-mark.svg" alt="" />
        <span class="brand-name">hipfire</span>
      </a>
      <nav class="topnav">
        <a href="/docs" class={path.startsWith("/docs") ? "active" : ""}>docs</a>
        <a href="/benchmarks/0.4.1" class={path.startsWith("/benchmarks") ? "active" : ""}>benchmarks</a>
        <a href="/#hardware">hardware</a>
        <a href="/learn" class={path.startsWith("/learn") ? "active" : ""}>learn</a>
        <a href="/blog" class={path.startsWith("/blog") ? "active" : ""}>blog</a>
        <a href="https://github.com/warpfront/hipfire/tree/beta">github</a>
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="hipfire home">
            <img class="brand-mark" src="/assets/hipfire-mark.svg" alt="" />
            <span class="brand-name">hipfire</span>
          </a>
          <span>LLM inference for AMD GPUs</span>
        </div>
        <nav class="footer-links" aria-label="footer">
          <a href="/docs">Docs</a>
          <a href="/benchmarks/0.4.1">Benchmarks</a>
          <a href="/learn">Learn</a>
          <a href="/blog">Blog</a>
          <a href="https://github.com/warpfront/hipfire/tree/beta">GitHub</a>
          <a href="https://discord.gg/F3BaywB8Rs">Discord</a>
          <a href="https://github.com/warpfront/hipfire/blob/beta/CHANGELOG.md">Changelog</a>
          <a href="/blog/rss.xml">RSS</a>
        </nav>
        <div class="footer-legal">
          Apache-2.0 / MIT &middot; <a href="https://github.com/warpfront/hipfire/blob/beta/LICENSE">LICENSE</a>
        </div>
      </div>
    </footer>
  </body>
</html>
