---
interface Props {
  /** Exact text placed on the clipboard. */
  text: string;
  /** Accessible name, e.g. "Copy install command". */
  label: string;
  variant?: "solid" | "ghost";
}

const { text, label, variant = "solid" } = Astro.props;
---

<button
  type="button"
  class:list={["mkt-copy", variant === "ghost" && "mkt-copy-ghost"]}
  data-copy={text}
  aria-label={label}
>
  <svg class="mkt-copy-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
    <rect x="5" y="5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
  <span class="mkt-copy-text">Copy</span>
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const status = btn.querySelector(".mkt-copy-text");
      try {
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Press Ctrl+C";
        const code = btn.closest(".mkt-install, .mkt-term")?.querySelector("code, pre");
        if (code) window.getSelection()?.selectAllChildren(code);
      }
      btn.classList.add("is-copied");
      window.setTimeout(() => {
        btn.classList.remove("is-copied");
        if (status) status.textContent = "Copy";
      }, 1800);
    });
  }
</script>
