---
import { haloCold, haloTc, qwen27b } from "../data/release041";
import { npuHeadline, haloMatrix } from "../data/release042";
import { a3bPrefill, a3bDecode, halo16k } from "../data/release043";

interface Props {
  /** Which release's tiles to show. */
  release?: "0.4.1" | "0.4.2" | "0.4.3" | "0.4.4";
  /** Path prefix for the detail links; "" when rendered on the benchmarks page itself. */
  linkBase?: string;
}

const { release = "0.4.4" } = Astro.props;
const { linkBase = `/benchmarks/${release}` } = Astro.props;

const fmt = (n: number, digits = 0) =>
  n.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });

const r9700_27b = qwen27b.gpus.find((g) => g.arch === "gfx1201")!;

const tiles041 = [
  {
    value: fmt(haloCold.decMtp.median, 1),
    unit: "tok/s",
    label: "Qwen3.8-Flash output speed on Strix Halo",
    ctx: "greedy decode with native speculative decoding (MTP) · median of 3 runs over 8 prompts",
    href: `${linkBase}#flash-next-halo-cold`,
  },
  {
    value: fmt(haloCold.pp8192.median),
    unit: "tok/s",
    label: "Prompt processing on Strix Halo",
    ctx: "Qwen3.8-Flash · 8K-token prompt",
    href: `${linkBase}#flash-next-halo-cold`,
  },
  {
    value: fmt(r9700_27b.pp8192),
    unit: "tok/s",
    label: "27B prompt processing on one Radeon AI PRO R9700",
    ctx: "Qwen3.8 27B · 8K-token prompt",
    href: `${linkBase}#flash-next-27b`,
  },
  {
    value: fmt(haloTc.medianSeconds, 1),
    unit: "s",
    label: "15 hard tool-calling tasks in under 3 minutes on Strix Halo",
    ctx: `Ciru's TC70–84 panel · median of ${haloTc.seeds.length} runs · ${haloTc.medianPoints}/30 points`,
    href: `${linkBase}#flash-next-halo`,
  },
];

const mtp042 = haloMatrix.decMtp.v042;
const tiles042 = [
  {
    value: fmt(npuHeadline.tps),
    unit: "tok/s",
    label: "Qwen3.8-Flash 16K prefill on Strix Halo with the NPU",
    ctx: `${fmt(npuHeadline.tokens)}-token prompt · TTFT ${fmt(npuHeadline.ttftMs)} ms · median of 3 × 3`,
    href: `${linkBase}#npu-headline`,
  },
  {
    value: "−10.1",
    unit: "%",
    label: "16K time to first token, NPU trunk auto vs off",
    ctx: "Strix Halo · default serve config · 3 fresh processes per arm",
    href: `${linkBase}#npu-headline`,
  },
  {
    value: "135.3",
    unit: "tok/s",
    label: "27B DFlash code decode on Strix Halo",
    ctx: "up from 97.9 (+38 %) · exact 16-row verify GEMMs",
    href: `${linkBase}#changes`,
  },
  mtp042
    ? {
        value: fmt(mtp042.median, 1),
        unit: "tok/s",
        label: "Qwen3.8-Flash output speed on Strix Halo",
        ctx: "greedy decode with native MTP · median of 3 runs over 8 prompts",
        href: `${linkBase}#halo-matrix`,
      }
    : {
        value: "4,308",
        unit: "tok/s",
        label: "Qwen3.8-Flash 16K prefill on two R9700s",
        ctx: "opt-in expert parallelism · one card 3,754",
        href: `${linkBase}#changes`,
      },
];

const pp8192 = a3bPrefill.rows.find((r) => r.pp === 8192)!;
const decCtx128 = a3bDecode.rows[0];

const tiles043 = [
  {
    value: fmt(pp8192.v043_mq4rs),
    unit: "tok/s",
    label: "Qwen3.6-35B-A3B mq4rs prefill on one Radeon AI PRO R9700",
    ctx: `pp8192 · ${fmt(pp8192.v042_mq4r)} on 0.4.2.1 mq4r (${pp8192.speedup.toFixed(1)}×) · median of 9 samples, 2026-10-24`,
    href: `${linkBase}#a3b-prefill`,
  },
  {
    value: fmt(decCtx128.pm4),
    unit: "tok/s",
    label: "Qwen3.6-35B-A3B mq4rs decode on the R9700 (0.4.3.1)",
    ctx: `tg128 · up from ${fmt(decCtx128.hip)} on the HIP route (+${decCtx128.pct} %) · 3 fresh processes`,
    href: `${linkBase}#a3b-decode`,
  },
  {
    value: "6,431",
    unit: "tok/s",
    label: "Qwen3.8-Flash 16K prefill on one R9700",
    ctx: "pp16384 · 5,405 at the 4096-row chunk (+19.0 %) · decode 5–10 % slower at the new default",
    href: `${linkBase}#flash-next-r9700`,
  },
  {
    value: fmt(halo16k.median, 1),
    unit: "tok/s",
    label: "Qwen3.8-Flash 16K prefill on Strix Halo with the NPU",
    ctx: `${fmt(halo16k.tokens)}-token prompt · all-9 median over 3 × 3 requests · NPU trunk on`,
    href: `${linkBase}#halo`,
  },
];

const tiles044 = [
  {
    value: "2,472.7",
    unit: "tok/s",
    label: "Qwen3.8-Flash 16K prefill on Strix Halo with the NPU",
    ctx: `Strix Halo + XDNA2 · 16,355-token prompt · cold serve TTFT 6.61 s · 3 fresh processes × 3 requests · 2026-10-27, release head 943b5323da`,
    href: `${linkBase}#measured-flash-next`,
  },
  {
    value: "141.1",
    unit: "tok/s",
    label: "Qwen3.8-27B decode with native MTP on a 7900 XTX",
    ctx: "7900 XTX · prose 1K · Q8 KV, 256 tokens, fresh-process ABBA · 2026-10-26, beta 085dd189b5 + #998",
    href: `${linkBase}#measured-27b`,
  },
  {
    value: "61.82",
    unit: "tok/s",
    label: "Qwen3.8-Flash-Next MTP decode on one R9700",
    ctx: "R9700 · 11-prompt MTP suite, 3 rounds of fresh processes · 2026-10-27, v0.4.4 RC2 125b2b5ca9",
    href: `${linkBase}#measured-flash-next`,
  },
  {
    value: "314.7",
    unit: "tok/s",
    label: "Qwen3.8-27B DFlash decode on one R9700 (code prompt)",
    ctx: "R9700 · humaneval_0, 128 tokens, 3 fresh processes · 2026-10-24, 0.4.4 verify tile loop 0a75dec554",
    href: `${linkBase}#measured-27b`,
  },
];

const tiles = release === "0.4.4" ? tiles044 : release === "0.4.3" ? tiles043 : release === "0.4.2" ? tiles042 : tiles041;
// The 0.4.4 tiles are README "Measured performance (v0.4.4)" cells (Halo 16K NPU, 7900 XTX 27B MTP prose-1K, R9700 Flash-Next MTP suite, R9700 27B DFlash code).
// The 0.4.3 tiles are the v0.4.3 / v0.4.3.1 release-notes headline rows (A3B prefill, A3B decode, Flash-Next 16K on the R9700, Halo 16K gate).
---

<div class="mkt-stats">
  {tiles.map((t) => (
    <a class="mkt-stat" href={t.href}>
      <div class="mkt-stat-val">
        {t.value}<span class="mkt-stat-unit">{t.unit}</span>
      </div>
      <div class="mkt-stat-label">{t.label}</div>
      <div class="mkt-stat-ctx">{t.ctx}</div>
    </a>
  ))}
</div>
